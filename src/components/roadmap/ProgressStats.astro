---
// 进度统计：总题数由服务端传入，完成数取 Supabase 与本地进度中较大者
interface Props {
  total?: number
}
const { total = 0 } = Astro.props
---

<section id='progress-stats' class='pstats' aria-label='刷题进度' data-total={total}>
  <div class='pstats-head'>
    <h2 class='mono'>Progress · 刷题进度</h2>
    <div id='stats-badge' class='mono'><span>加载中…</span></div>
  </div>
  <div class='pstats-bar'>
    <div id='progress-bar' style='width: 0%'>
      <span id='progress-text' class='sr-only'></span>
    </div>
  </div>
  <dl class='pstats-grid'>
    <div><dt>已完成</dt><dd id='completed-count'>0</dd></div>
    <div><dt>总题数</dt><dd id='total-count'>0</dd></div>
    <div><dt>待完成</dt><dd id='remaining-count'>0</dd></div>
  </dl>
</section>

<script>
  import { getProgressStats } from '@/lib/supabaseClient'

  async function updateProgressDisplay() {
    // 计算总题目数（题单在 <template> 里，DOM 计数可能为 0，回退到服务端传入的总数）
    const root = document.getElementById('progress-stats')
    const domCount = document.querySelectorAll('.prob-check').length
    const totalProblems = domCount || Number(root?.dataset.total || 0)

    // 获取进度统计：远端（若配置了 Supabase）与本地浏览器进度取较大者
    const remote = await getProgressStats(totalProblems)
    let local = 0
    try {
      const fromWindow = (window as any).roadmapData?.progress
      const saved = fromWindow && Object.keys(fromWindow).length
        ? fromWindow
        : JSON.parse(localStorage.getItem('algo-roadmap-progress') || '{}')
      local = Object.values(saved).filter(Boolean).length
    } catch {
      local = 0
    }
    const completed = Math.min(totalProblems, Math.max(remote.completed, local))
    const stats = {
      total: totalProblems,
      completed,
      percentage: totalProblems ? Math.round((completed / totalProblems) * 100) : 0
    }

    // 更新 UI
    const progressBar = document.getElementById('progress-bar')
    const progressText = document.getElementById('progress-text')
    const statsBadge = document.getElementById('stats-badge')
    const completedCount = document.getElementById('completed-count')
    const totalCount = document.getElementById('total-count')
    const remainingCount = document.getElementById('remaining-count')

    if (progressBar && progressText && statsBadge && completedCount && totalCount && remainingCount) {
      // 动画效果：延迟设置宽度
      setTimeout(() => {
        progressBar.style.width = `${stats.percentage}%`
        progressText.textContent = `${stats.percentage}%`
      }, 100)

      statsBadge.textContent = `${stats.completed} / ${stats.total} · ${stats.percentage}%`

      completedCount.textContent = stats.completed.toString()
      totalCount.textContent = stats.total.toString()
      remainingCount.textContent = (stats.total - stats.completed).toString()
    }
  }

  // 页面加载时更新进度
  document.addEventListener('DOMContentLoaded', updateProgressDisplay)

  // 监听自定义事件，当题目状态改变时更新进度
  document.addEventListener('problem-status-changed', updateProgressDisplay)
  window.addEventListener('roadmap-updated', updateProgressDisplay)
  window.addEventListener('roadmap-data-loaded', updateProgressDisplay)
</script>

<style>
  .pstats {
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
    background: hsl(var(--card));
    padding: 1rem 1.125rem;
  }
  .pstats-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .pstats-head h2 {
    margin: 0;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
  }
  #stats-badge {
    color: hsl(var(--foreground));
    font-variant-numeric: tabular-nums;
  }
  #stats-badge :global(span) {
    font-size: 0.85rem;
  }
  .pstats-bar {
    height: 6px;
    background: hsl(var(--muted));
    border-radius: 3px;
    overflow: hidden;
  }
  #progress-bar {
    height: 100%;
    background: hsl(var(--primary));
    border-radius: 3px;
    transition: width 0.5s ease;
  }
  .pstats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0.875rem 0 0;
  }
  .pstats-grid dt {
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
  }
  .pstats-grid dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--foreground));
  }
</style>
