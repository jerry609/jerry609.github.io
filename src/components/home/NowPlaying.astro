---
import type { CollectionEntry } from 'astro:content'

import { LAYERS, layerColor, layerLabel, SERIES } from '@/data/stack'

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

// Rough reading time: ~400 CJK characters or ~220 latin words per minute
function minutes(body = '') {
  const cjk = (body.match(/[㐀-鿿]/g) || []).length
  const words = (body.replace(/[㐀-鿿]/g, ' ').match(/[A-Za-z0-9_]+/g) || []).length
  return Math.max(1, Math.round(cjk / 400 + words / 220))
}
const seriesOf = (id: string) => SERIES.find((s) => (s.slugs as readonly string[]).includes(id))?.title

const tracks = posts.map((p) => ({
  s: p.id,
  t: p.data.title,
  x: p.data.description,
  d: p.data.publishDate.toISOString().slice(0, 10),
  l: layerLabel(p.data.layer),
  lid: p.data.layer,
  c: layerColor(p.data.layer),
  cu: layerColor(p.data.layer, true),
  m: minutes(p.body),
  a: seriesOf(p.id) ?? ''
}))
const first = tracks[0]
const pad = (n: number) => String(n).padStart(2, '0')
---

<section class='player' id='now-playing' aria-label='正在播放：最近的文章' tabindex='-1'>
  <div class='win-chrome mono'>
    <span class='crumb'>
      jerry609 &gt; reading-queue &gt; <strong data-np='idx'>{pad(1)} / {pad(tracks.length)}</strong>
    </span>
    <span class='win-series' data-np='album' hidden={!first.a}>{first.a}</span>
  </div>

  <div class='win-body'>
    <div class='win-top'>
      <div class='track'>
        <p class='kicker mono'>
          <span class='eq' aria-hidden='true'><i></i><i></i><i></i><i></i></span>
          <span class='layer-chip'>
            <span class='sq-dot' data-np='dot' style={`background:${first.c}`}></span>
            <span data-np='layer'>{first.l}</span>
          </span>
          <span class='date-chip' data-np='date'>{first.d}</span>
        </p>
        <a class='title' data-np='title' href={`/blog/${first.s}`}>{first.t}</a>
        <p class='desc' data-np='desc'>{first.x}</p>
      </div>

      <div class='controls'>
        <button type='button' class='ctl' data-np='prev' aria-label='上一篇'>⟨⟨</button>
        <a class='ctl play' data-np='play' href={`/blog/${first.s}`} aria-label='阅读这篇'>▶</a>
        <button type='button' class='ctl' data-np='next' aria-label='下一篇'>⟩⟩</button>
      </div>
    </div>

    <div class='progress mono'>
      <span>QUEUE</span>
      <span class='bar' aria-hidden='true'>
        <i data-np='bar' style={`width:${(100 / tracks.length).toFixed(2)}%;background:${first.cu}`}></i>
      </span>
      <span class='readout len' data-np='len' title='预计阅读时长'>{pad(first.m)}:00</span>
    </div>

    <div class='stepper' aria-label='按技术栈筛选'>
      {
        LAYERS.map((l) => (
          <button
            type='button'
            class:list={['step-node', l.id === first.lid && 'active']}
            data-step-layer={l.id}
            style={`--node-c:${l.uiColor}`}
          >
            <span class='step-bar' />
            <span class='mono'>{l.code} {l.name}</span>
          </button>
        ))
      }
    </div>
  </div>

  <script type='application/json' data-np='data' set:html={JSON.stringify(tracks)} />
</section>

<script>
  type T = { s: string; t: string; x: string; d: string; l: string; lid: string; c: string; cu: string; m: number; a: string }
  const root = document.getElementById('now-playing')
  const data = root?.querySelector<HTMLScriptElement>('[data-np="data"]')
  if (root && data) {
    const tracks: T[] = JSON.parse(data.textContent || '[]')
    const $ = (k: string) => root.querySelector<HTMLElement>(`[data-np="${k}"]`)!
    const pad = (n: number) => String(n).padStart(2, '0')
    let i = 0
    const show = (next: number) => {
      i = (next + tracks.length) % tracks.length
      const t = tracks[i]
      $('idx').textContent = `${pad(i + 1)} / ${pad(tracks.length)}`
      $('layer').textContent = t.l
      $('dot').style.background = t.c
      $('album').textContent = t.a
      $('album').hidden = !t.a
      $('title').textContent = t.t
      ;($('title') as HTMLAnchorElement).href = `/blog/${t.s}`
      ;($('play') as HTMLAnchorElement).href = `/blog/${t.s}`
      $('desc').textContent = t.x
      $('date').textContent = t.d
      $('len').textContent = `${pad(t.m)}:00`
      $('bar').style.width = `${(((i + 1) / tracks.length) * 100).toFixed(2)}%`
      $('bar').style.background = t.cu
      root.querySelectorAll<HTMLButtonElement>('[data-step-layer]').forEach((b) => {
        b.classList.toggle('active', b.dataset.stepLayer === t.lid)
      })
      root.classList.remove('flip')
      void root.offsetWidth
      root.classList.add('flip')
    }
    $('prev').addEventListener('click', () => show(i - 1))
    $('next').addEventListener('click', () => show(i + 1))
    root.querySelectorAll<HTMLButtonElement>('[data-step-layer]').forEach((b) => {
      b.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('stack:change', { detail: b.dataset.stepLayer }))
        document.getElementById('writing')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    })
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1)
      if (e.key === 'ArrowRight') show(i + 1)
    })
  }
</script>

<style>
  .player {
    border: 1.5px solid var(--ink-hard, #171716);
    border-radius: 6px;
    background: hsl(var(--card));
    overflow: hidden;
    outline: none;
  }
  .win-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 0.68rem;
    color: hsl(var(--faint));
  }
  .crumb strong {
    color: hsl(var(--foreground));
    font-weight: 500;
  }
  .win-series {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win-body {
    padding: 1.1rem 1.25rem 1rem;
  }
  .win-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .track {
    min-width: 0;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    margin: 0 0 0.45rem;
    font-size: 0.68rem;
    color: hsl(var(--faint));
  }
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 13px;
  }
  .eq i {
    display: block;
    width: 2.5px;
    height: 100%;
    background: var(--c-l6, #fa6d01);
    transform-origin: bottom;
    animation: eq 1.1s steps(4, end) infinite;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.7s;
  }
  .eq i:nth-child(4) {
    animation-delay: -0.15s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.28);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .layer-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 7px;
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .title {
    display: block;
    font-weight: 500;
    font-size: 1.08rem;
    line-height: 1.38;
    letter-spacing: -0.018em;
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .title:hover {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .desc {
    margin: 0.35rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .flip .track {
    animation: flip 0.22s steps(3, end);
  }
  @keyframes flip {
    from {
      opacity: 0.3;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }
  .ctl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1.5px solid var(--ink-hard, #171716);
    border-radius: 2px;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
    cursor: pointer;
  }
  .ctl:hover {
    background: hsl(var(--muted));
  }
  .ctl.play {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .ctl.play:hover {
    background: var(--c-l6, #fa6d01);
    border-color: var(--c-l6, #fa6d01);
    color: #fff;
  }
  .progress {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    font-size: 0.68rem;
    color: hsl(var(--faint));
    margin-bottom: 0.85rem;
  }
  .bar {
    height: 3px;
    background: hsl(var(--muted));
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    transition: width 0.28s ease;
  }
  .len {
    color: hsl(var(--foreground));
  }
  .stepper {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
    padding-top: 0.7rem;
    border-top: 1px solid hsl(var(--border));
  }
  .step-node {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: hsl(var(--faint));
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .step-bar {
    display: block;
    height: 3px;
    background: hsl(var(--muted));
    transition: background-color 0.2s ease;
  }
  .step-node.active,
  .step-node:hover {
    color: hsl(var(--foreground));
  }
  .step-node.active .step-bar {
    background: var(--node-c, var(--c-l6));
  }
  @media (max-width: 640px) {
    .win-top {
      flex-direction: column;
    }
    .stepper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eq i,
    .flip .track {
      animation: none;
    }
  }
</style>
