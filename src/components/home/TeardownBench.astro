---
/**
 * Interactive 3D GPU / NPU Hardware × Agent-Infra Teardown Bench.
 * Real Three.js WebGL PBR studio renderer (RoomEnvironment IBL, soft shadows,
 * dual GPU/NPU silicon micro-architecture, half-section cutaway, 8-layer explosion,
 * 3D raycast picking, margin-pinned CAD callouts, Roofline & 4-channel oscilloscope).
 * Inspired by elvarofficial/teardown & Ayush Soni (@ayushsoni_io) Swiss print-craft.
 */
---

<section class='td-wrap' id='teardown-lab' aria-label='可拆解 GPU 与 NPU AI 加速器 3D 交互机台'>
  <div class='sec-head'>
    <h2 class='sec-title'>Teardown Lab<span class='zh'>可拆解 GPU / NPU AI 加速器 3D 机台</span></h2>
    <span class='sec-note mono'>WEBGL PBR · GPU ⇄ NPU · CLICK 3D PART TO INSPECT</span>
  </div>

  <div class='td-shell' id='tdShell'>
    <!-- Auto-tour animated operator cursor + click ripple -->
    <div class='td-cursor' id='tdCursor' aria-hidden='true'>
      <svg width='22' height='22' viewBox='0 0 34 34'>
        <path
          d='M4 3 L30 13.5 L17.5 17.5 L13.5 30 Z'
          fill='#171716'
          stroke='#FFFFFF'
          stroke-width='2.4'
          stroke-linejoin='round'></path>
      </svg>
    </div>
    <div class='td-ring' id='tdRing' aria-hidden='true'></div>

    <div class='td-header'>
      <div class='td-brand'>
        <span class='td-bar' aria-hidden='true'></span>
        <div>
          <div class='td-title' id='tdArchTitle'>
            AI Accelerator <span style='color:var(--c-l6)'>·</span> B200-SXM Dual-Reticle GPU Teardown
          </div>
          <div class='td-sub' id='tdArchSpec'>
            BF16 1,979 TFLOPS PEAK · 8× HBM3E 8.0 TB/S · 10 TB/S NV-HBI · 2.5D CoWoS-L
          </div>
        </div>
      </div>

      <div class='td-head-actions'>
        <div class='td-arch-switch' id='tdArchSwitch' role='group' aria-label='切换 GPU 或 NPU 架构'>
          <button class='td-arch-btn active' data-arch='gpu' type='button'>GPU · SXM</button>
          <button class='td-arch-btn' data-arch='npu' type='button'>NPU · DA VINCI</button>
        </div>
        <button class='td-tourchip on' id='tdTourChip' type='button'>
          <i></i><span id='tdTourText'>AUTO TOUR · TAKE OVER</span>
        </button>
      </div>
    </div>

    <div class='td-workspace'>
      <!-- Left: Primary Throughput + Live Roofline + Precision + Transport & Sliders -->
      <div class='td-col'>
        <div class='td-panel'>
          <div class='td-cap'>
            <span>THROUGHPUT</span>
            <span id='tdRegimeTag' style='color:var(--c-l6)'>COMPUTE-BOUND</span>
          </div>
          <div class='td-big-num' id='tdTflops'>1,680</div>
          <div class='td-big-unit' id='tdBigUnit'>TFLOPS · BF16 TENSOR CORES</div>
          <div class='td-meter'><div class='td-meter-fill' id='tdTflopsFill' style='width:85%'></div></div>
          <div class='td-kv-grid'>
            <div><div class='td-kv-k'>HBM3E BW</div><div class='td-kv-v' id='tdHbmBw'>6.84 TB/s</div></div>
            <div><div class='td-kv-k'>ARITH INTENS</div><div class='td-kv-v' id='tdAiVal'>344 OP/B</div></div>
            <div><div class='td-kv-k'>MFU UTIL</div><div class='td-kv-v' id='tdMfuVal'>84.9%</div></div>
            <div><div class='td-kv-k'>L2 / SRAM HIT</div><div class='td-kv-v' id='tdL2Val'>74%</div></div>
            <div><div class='td-kv-k' id='tdLinkLabel'>NVLINK 5.0</div><div class='td-kv-v' id='tdLinkVal'>288 GB/s</div></div>
            <div><div class='td-kv-k'>POWER / DIE</div><div class='td-kv-v' id='tdPowerVal'>845W · 66°C</div></div>
          </div>
        </div>

        <div class='td-panel'>
          <div class='td-cap'>
            <span>ROOFLINE · LOG-LOG</span>
            <div class='td-prec-pills' id='tdPrecGroup'>
              <button class='td-mini-pill' data-prec='fp8' type='button'>FP8</button>
              <button class='td-mini-pill active' data-prec='bf16' type='button'>BF16</button>
              <button class='td-mini-pill' data-prec='fp32' type='button'>FP32</button>
            </div>
          </div>
          <svg id='tdRooflineSvg' viewBox='0 0 220 104' width='100%' height='102' style='display:block'></svg>
          <div class='td-axis-row'>
            <span>1 OP/B</span><span id='tdRidgeLabel'>RIDGE 247</span><span>2000 OP/B</span>
          </div>
        </div>

        <div class='td-panel'>
          <div class='td-transport'>
            <button class='td-btn active' id='tdPauseBtn' type='button'>❚❚ PAUSE</button>
            <button class='td-btn' id='tdStepBack' type='button'>−1 CYC</button>
            <button class='td-btn' id='tdStepFwd' type='button'>+1 CYC</button>
          </div>
          <div class='td-slider-row'>
            <div class='td-slider-head'><span>BATCH SIZE (B)</span><strong id='tdBatchVal'>32</strong></div>
            <input class='td-range' id='tdBatchSlider' type='range' min='1' max='256' value='32' />
          </div>
          <div class='td-slider-row'>
            <div class='td-slider-head'><span>EXPLODE GAP</span><strong id='tdExplodeVal'>12%</strong></div>
            <input class='td-range' id='tdExplodeSlider' type='range' min='0' max='100' value='12' />
          </div>
        </div>
      </div>

      <!-- Center: Real Three.js WebGL PBR 3D Hardware Viewport -->
      <div class='td-stage' id='tdStage'>
        <canvas id='tdCanvas'></canvas>
        <svg class='td-callout-svg' id='tdCalloutSvg' aria-hidden='true'></svg>
        <div class='td-callout-layer' id='tdCalloutLayer' aria-hidden='true'></div>
        <div class='td-hover-tip' id='tdHoverTip' hidden>
          <div class='td-tip-k' id='tdTipLayer'>L2 SYSTEMS</div>
          <div class='td-tip-t' id='tdTipTitle'>HBM3E 12-HI</div>
          <div class='td-tip-s' id='tdTipSub'>192 GB · 8.0 TB/s</div>
        </div>

        <div class='td-stage-top'>
          <div class='td-legend'>
            <span><i style='background:var(--c-l6)'></i>COMPUTE</span>
            <span><i style='background:var(--c-l5)'></i>HBM3E/IO</span>
            <span><i style='background:var(--c-l2)'></i>CoWoS/UB</span>
            <span><i style='background:var(--c-l4)'></i>KV/VEC</span>
          </div>
          <div class='td-badge' id='tdActivePart'>GPU · HALF CUTAWAY</div>
        </div>

        <div class='td-stage-bot'>
          <div class='td-layer-picker' id='tdLayerPicker'>
            <button class='td-btn ink-active' data-iso='ALL' type='button'>ALL</button>
            <button class='td-btn' data-iso='thermal' type='button'>COLD PLATE</button>
            <button class='td-btn' data-iso='kv' type='button'>KV / SRAM</button>
            <button class='td-btn' data-iso='compute' type='button'>DIE CORES</button>
            <button class='td-btn' data-iso='hbm' type='button'>HBM3E ×8</button>
            <button class='td-btn' data-iso='interposer' type='button'>CoWoS</button>
            <button class='td-btn' data-iso='io' type='button'>NVLINK/IO</button>
            <button class='td-btn' data-iso='pcb' type='button'>PCB+BGA</button>
          </div>
          <div class='td-hint'>DRAG TO ORBIT 3D · SCROLL TO ZOOM · CLICK ANY 3D HARDWARE BLOCK TO ISOLATE</div>
        </div>
      </div>

      <!-- Right: Workload / Cutaway / Camera + 4-Channel Pipeline Oscilloscope -->
      <div class='td-col td-col--right'>
        <div class='td-panel'>
          <div class='td-cap'><span>WORKLOAD</span><span>REAL-TIME</span></div>
          <div class='td-btn-grid' id='tdWorkloads'>
            <button class='td-btn active' data-wl='prefill' type='button'>PREFILL GEMM</button>
            <button class='td-btn' data-wl='decode' type='button'>DECODE KV</button>
            <button class='td-btn' data-wl='flashattn' type='button'>FLASHATTN</button>
            <button class='td-btn' data-wl='allreduce' type='button'>ALLREDUCE</button>
          </div>

          <div class='td-cap' style='margin-top:8px'><span>CUTAWAY</span><span>OPEN UP</span></div>
          <div class='td-btn-grid' id='tdCutaways'>
            <button class='td-btn' data-cut='assembled' type='button'>ASSEMBLED</button>
            <button class='td-btn ink-active' data-cut='cutaway' type='button'>HALF CUT</button>
            <button class='td-btn' data-cut='exploded' type='button'>EXPLODED</button>
            <button class='td-btn' data-cut='xray' type='button'>X-RAY</button>
          </div>

          <div class='td-cap' style='margin-top:8px'><span>CAMERA VIEW</span><span>ORBIT</span></div>
          <div class='td-btn-grid' id='tdCams' style='margin-bottom:0'>
            <button class='td-btn ink-active' data-cam='hero' type='button'>HERO 3/4</button>
            <button class='td-btn' data-cam='floorplan' type='button'>FLOORPLAN</button>
            <button class='td-btn' data-cam='section' type='button'>SECTION</button>
            <button class='td-btn' data-cam='hbm' type='button'>HBM ZOOM</button>
            <button class='td-btn' data-cam='io' type='button'>IO LINK</button>
          </div>
        </div>

        <div class='td-panel'>
          <div class='td-cap'>
            <span>PIPELINE TELEMETRY</span>
            <span id='tdPhaseTag'>φ 048°</span>
          </div>
          <svg id='tdWaveSvg' viewBox='0 0 228 112' width='100%' height='110' style='display:block'></svg>
          <p class='td-note' id='tdSubsystemNote'>
            GPU Prefill (B=32, BF16)：大矩阵 GEMM 算术强度 344 OP/B，5th-Gen Tensor Core 与 10 TB/s NV-HBI 桥接进入高 MFU 算力区。
          </p>
        </div>

        <div class='td-panel' style='padding:10px 11px'>
          <div class='td-cap' style='margin-bottom:5px'><span>OVERLAYS &amp; STACK MAP</span></div>
          <div class='td-btn-grid' style='margin-bottom:0'>
            <button class='td-btn ink-active' id='tdCalloutToggle' type='button'>CALLOUTS: ON</button>
            <button class='td-btn ink-active' id='tdHaloToggle' type='button'>HALO: ON</button>
            <button class='td-btn' id='tdFilterJump' type='button'>READ NOTES &gt;</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import type {
    AcceleratorTeardownEngine,
    ArchMode,
    CameraPreset,
    CutawayMode,
    HardwareTelemetry,
    PartId,
    PrecisionMode,
    WorkloadMode
  } from '@/lib/teardown-engine'

  const shell = document.getElementById('tdShell')
  const stage = document.getElementById('tdStage')
  const canvas = document.getElementById('tdCanvas') as HTMLCanvasElement | null

  if (shell && stage && canvas) {
    let booted = false
    const bootBench = async () => {
      if (booted) return
      booted = true
      const { AcceleratorTeardownEngine: EngineCtor, PART_CATALOG } = await import('@/lib/teardown-engine')
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // DOM refs
    const archTitleEl = document.getElementById('tdArchTitle')!
    const archSpecEl = document.getElementById('tdArchSpec')!
    const tflopsEl = document.getElementById('tdTflops')!
    const bigUnitEl = document.getElementById('tdBigUnit')!
    const tflopsFillEl = document.getElementById('tdTflopsFill')!
    const regimeTagEl = document.getElementById('tdRegimeTag')!
    const hbmBwEl = document.getElementById('tdHbmBw')!
    const aiValEl = document.getElementById('tdAiVal')!
    const mfuValEl = document.getElementById('tdMfuVal')!
    const l2ValEl = document.getElementById('tdL2Val')!
    const linkLabelEl = document.getElementById('tdLinkLabel')!
    const linkValEl = document.getElementById('tdLinkVal')!
    const powerValEl = document.getElementById('tdPowerVal')!
    const phaseTagEl = document.getElementById('tdPhaseTag')!
    const ridgeLabelEl = document.getElementById('tdRidgeLabel')!
    const noteEl = document.getElementById('tdSubsystemNote')!
    const activePartEl = document.getElementById('tdActivePart')!
    const roofSvg = document.getElementById('tdRooflineSvg')!
    const waveSvg = document.getElementById('tdWaveSvg')!
    const calloutSvg = document.getElementById('tdCalloutSvg')!
    const calloutLayer = document.getElementById('tdCalloutLayer')!
    const hoverTip = document.getElementById('tdHoverTip')!
    const tipLayer = document.getElementById('tdTipLayer')!
    const tipTitle = document.getElementById('tdTipTitle')!
    const tipSub = document.getElementById('tdTipSub')!

    const pauseBtn = document.getElementById('tdPauseBtn')!
    const batchSlider = document.getElementById('tdBatchSlider') as HTMLInputElement
    const batchValEl = document.getElementById('tdBatchVal')!
    const explodeSlider = document.getElementById('tdExplodeSlider') as HTMLInputElement
    const explodeValEl = document.getElementById('tdExplodeVal')!
    const tourChip = document.getElementById('tdTourChip')!
    const tourText = document.getElementById('tdTourText')!
    const cursorEl = document.getElementById('tdCursor')!
    const ringEl = document.getElementById('tdRing')!
    const calloutToggle = document.getElementById('tdCalloutToggle')!
    const haloToggle = document.getElementById('tdHaloToggle')!

    let autoTour = !reduce
    let tourTimer: number | null = null
    let tourStep = 0
    let calloutsOn = true
    let haloOn = true
    let wavePhase = 0

    const stopTour = () => {
      if (!autoTour) return
      autoTour = false
      if (tourTimer) clearTimeout(tourTimer)
      tourChip.classList.remove('on')
      tourText.textContent = 'MANUAL · RESUME TOUR'
      cursorEl.style.opacity = '0'
    }

    const updateArchBanner = (arch: ArchMode, prec: PrecisionMode) => {
      const peak = Math.round((arch === 'gpu' ? 1979 : 800) * (prec === 'fp8' ? 2 : prec === 'bf16' ? 1 : 0.25))
      const precU = prec.toUpperCase()
      if (arch === 'gpu') {
        archTitleEl.innerHTML = `AI Accelerator <span style="color:var(--c-l6)">·</span> B200-SXM Dual-Reticle GPU Teardown`
        archSpecEl.textContent = `${precU} ${peak.toLocaleString()} TFLOPS PEAK · 8× HBM3E 8.0 TB/S · 10 TB/S NV-HBI · 2.5D CoWoS-L`
        bigUnitEl.textContent = `TFLOPS · ${precU} TENSOR CORES`
        linkLabelEl.textContent = 'NVLINK 5.0'
      } else {
        archTitleEl.innerHTML = `AI Accelerator <span style="color:var(--c-l6)">·</span> Da Vinci NPU Cube+Vector Teardown`
        archSpecEl.textContent = `${precU} ${peak.toLocaleString()} TFLOPS PEAK · 8× HBM3 3.2 TB/S · MTE1/2/3 DMA · L1 UB SRAM`
        bigUnitEl.textContent = `TFLOPS · ${precU} CUBE MATRIX`
        linkLabelEl.textContent = 'HCCS OPTICAL'
      }
    }

    const updateBadge = (eng: AcceleratorTeardownEngine) => {
      const s = eng.getState()
      const archTag = s.arch.toUpperCase()
      const cutTag =
        s.cutaway === 'cutaway'
          ? 'HALF CUTAWAY'
          : s.cutaway === 'exploded'
            ? 'EXPLODED'
            : s.cutaway === 'xray'
              ? 'X-RAY GLASS'
              : 'ASSEMBLED'
      const partTag = s.isolate === 'ALL' ? cutTag : `${PART_CATALOG[s.arch][s.isolate].id.toUpperCase()} ISOLATED`
      activePartEl.textContent = `${archTag} · ${partTag}`
    }

    const renderTelemetry = (hw: HardwareTelemetry) => {
      const isDark = document.documentElement.classList.contains('dark')
      wavePhase += 0.35

      tflopsEl.textContent = Math.round(hw.achievedTflops).toLocaleString()
      tflopsFillEl.style.width = `${Math.min(100, hw.mfu).toFixed(1)}%`
      const regColor =
        hw.regime === 'COMPUTE-BOUND'
          ? 'var(--c-l6)'
          : hw.regime === 'MEMORY-BOUND'
            ? 'var(--c-l5)'
            : 'var(--c-l2)'
      regimeTagEl.textContent = hw.regime
      regimeTagEl.style.color = regColor
      tflopsEl.style.color = regColor
      tflopsFillEl.style.background = regColor

      hbmBwEl.textContent = `${hw.hbmBw.toFixed(2)} TB/s`
      aiValEl.textContent = `${Math.round(hw.ai)} OP/B`
      mfuValEl.textContent = `${hw.mfu.toFixed(1)}%`
      l2ValEl.textContent = `${Math.round(hw.l2Hit)}%`
      linkValEl.textContent = `${Math.round(hw.linkGbps)} GB/s`
      powerValEl.textContent = `${hw.tdpWatts}W · ${hw.tempC}°C`
      phaseTagEl.textContent = `φ ${String(hw.phaseDeg).padStart(3, '0')}°`
      ridgeLabelEl.textContent = `RIDGE ${Math.round(hw.ridgePoint)}`
      noteEl.textContent = hw.note

      // 1. Dynamic Log-Log Roofline SVG
      const logX = (aiVal: number) => 10 + (Math.log10(Math.max(1, Math.min(2000, aiVal))) / Math.log10(2000)) * 200
      const maxPlotY = Math.max(4200, hw.peakTflops * 1.15)
      const logY = (tf: number) => 94 - (Math.log10(Math.max(4, tf)) / Math.log10(maxPlotY)) * 82
      const rx = logX(hw.ridgePoint)
      const ry = logY(hw.peakTflops)
      const y1 = logY(Math.max(4, hw.peakHbmBw))
      const px = logX(hw.ai)
      const py = logY(Math.max(4, hw.achievedTflops))
      const lineInk = isDark ? '#F0F0EF' : '#171716'
      const gridInk = isDark ? '#2E2E2B' : '#E0E0DC'
      const dotHex =
        hw.regime === 'COMPUTE-BOUND' ? '#FA6D01' : hw.regime === 'MEMORY-BOUND' ? '#2B5CFF' : '#00CD6E'

      roofSvg.innerHTML = `
        <line x1="10" y1="94" x2="210" y2="94" stroke="${gridInk}" stroke-width="1"/>
        <line x1="10" y1="${ry.toFixed(1)}" x2="210" y2="${ry.toFixed(1)}" stroke="${gridInk}" stroke-dasharray="2 2"/>
        <line x1="${rx.toFixed(1)}" y1="10" x2="${rx.toFixed(1)}" y2="94" stroke="${gridInk}" stroke-dasharray="3 2"/>
        <polyline points="10,${y1.toFixed(1)} ${rx.toFixed(1)},${ry.toFixed(1)} 210,${ry.toFixed(1)}" fill="none" stroke="${lineInk}" stroke-width="1.8"/>
        <line x1="${px.toFixed(1)}" y1="${py.toFixed(1)}" x2="${px.toFixed(1)}" y2="94" stroke="${dotHex}" stroke-width="1" stroke-dasharray="2 2"/>
        <circle cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="4.8" fill="${dotHex}" stroke="${isDark ? '#141413' : '#FFFFFF'}" stroke-width="1.5"/>
      `

      // 2. 4-Channel Synchronized Hardware Pipeline Oscilloscope
      const traces =
        hw.arch === 'gpu'
          ? [
              { name: 'TMA/DMA', color: '#00CD6E', duty: hw.dmaDuty, ph: 0 },
              { name: 'TENSOR', color: '#FA6D01', duty: hw.mmaDuty, ph: 1.4 },
              { name: 'SFU/VEC', color: '#DE99FE', duty: hw.vecDuty, ph: 2.5 },
              { name: 'NVLINK', color: '#2B5CFF', duty: hw.commDuty, ph: 3.4 }
            ]
          : [
              { name: 'MTE DMA', color: '#00CD6E', duty: hw.dmaDuty, ph: 0 },
              { name: 'CUBE', color: '#FA6D01', duty: hw.mmaDuty, ph: 1.2 },
              { name: 'VECTOR', color: '#DE99FE', duty: hw.vecDuty, ph: 2.3 },
              { name: 'HCCS', color: '#2B5CFF', duty: hw.commDuty, ph: 3.3 }
            ]

      let wHtml = ''
      traces.forEach((tr, ti) => {
        const y0 = 16 + ti * 26
        wHtml += `<text x="2" y="${y0 + 3}" font-family="Geist Mono Variable, ui-monospace, monospace" font-size="8.2" fill="${isDark ? '#9E9E9A' : '#666662'}">${tr.name}</text>`
        let pts = ''
        for (let i = 0; i <= 26; i++) {
          const x = 52 + i * 6.6
          const s = Math.sin(wavePhase * 0.6 + i * 0.52 + tr.ph)
          const hi = s > 0.85 - tr.duty * 1.45 ? 1 : 0
          pts += `${x.toFixed(1)},${(hi ? y0 - 7 : y0 + 5).toFixed(1)} `
        }
        wHtml += `<polyline points="${pts}" fill="none" stroke="${tr.color}" stroke-width="1.55" stroke-linejoin="round"/>`
      })
      waveSvg.innerHTML = wHtml
    }

    // Margin-pinned zero-overlap CAD Callout Renderer (diff-cached to avoid DOM thrashing)
    let lastCalloutSig = ''
    const renderCallouts = (
      items: {
        id: Exclude<PartId, 'ALL'>
        x: number
        y: number
        side: 'left' | 'right'
        title: string
        sub: string
        color: string
        visible: boolean
      }[]
    ) => {
      const w = stage.clientWidth
      const h = stage.clientHeight
      if (!w || !h || !items.length) {
        if (lastCalloutSig !== '') {
          lastCalloutSig = ''
          calloutSvg.innerHTML = ''
          calloutLayer.innerHTML = ''
        }
        return
      }
      const isDark = document.documentElement.classList.contains('dark')
      const sig = `${isDark ? 1 : 0}|${w}|${h}|${items.map((it) => (it.visible ? `${it.id}:${Math.round(it.x)},${Math.round(it.y)}:${it.sub}` : '')).join(';')}`
      if (sig === lastCalloutSig) return
      lastCalloutSig = sig
      calloutSvg.setAttribute('viewBox', `0 0 ${w} ${h}`)

      const lineStroke = isDark ? 'rgba(240,240,239,0.45)' : 'rgba(23,23,22,0.42)'
      let svgOut = ''
      let htmlOut = ''

      const leftSlots = [76, Math.max(180, h - 142)]
      const rightSlots = [92, Math.max(198, h - 132)]
      let li = 0
      let ri = 0

      for (const it of items) {
        if (!it.visible) continue
        const isLeft = it.side === 'left'
        const tagY = isLeft ? leftSlots[li++ % leftSlots.length] : rightSlots[ri++ % rightSlots.length]
        const tagEdgeX = isLeft ? 178 : w - 178
        const elbowX = isLeft ? tagEdgeX + 14 : tagEdgeX - 14

        svgOut += `
          <polyline points="${tagEdgeX},${tagY} ${elbowX},${tagY} ${it.x.toFixed(1)},${it.y.toFixed(1)}" fill="none" stroke="${lineStroke}" stroke-width="1"/>
          <circle cx="${it.x.toFixed(1)}" cy="${it.y.toFixed(1)}" r="3.4" fill="${it.color}" stroke="${isDark ? '#141413' : '#FFFFFF'}" stroke-width="1.2"/>
        `
        htmlOut += `
          <div class="td-tag ${isLeft ? 'is-left' : 'is-right'}" style="top:${tagY}px;border-left-color:${it.color}">
            <div class="td-tag-t">${it.title}</div>
            <div class="td-tag-s">${it.sub}</div>
          </div>
        `
      }
      calloutSvg.innerHTML = svgOut
      calloutLayer.innerHTML = htmlOut
    }

    let engine: AcceleratorTeardownEngine | null = null
    try {
      engine = new EngineCtor(stage, canvas, {
        onTelemetry: renderTelemetry,
        onCalloutsUpdate: renderCallouts,
        onHoverPart: (part, x, y) => {
          if (!part) {
            hoverTip.hidden = true
            return
          }
          tipLayer.textContent = `${part.blogLabel} · CLICK TO ISOLATE`
          tipLayer.style.color = part.color
          tipTitle.textContent = part.title
          tipSub.textContent = part.subtitle
          hoverTip.hidden = false
          const tx = Math.min(stage.clientWidth - 196, Math.max(12, x + 14))
          const ty = Math.min(stage.clientHeight - 90, Math.max(46, y - 24))
          hoverTip.style.transform = `translate(${tx}px, ${ty}px)`
        },
        onSelectPart: (partId) => {
          document.querySelectorAll<HTMLButtonElement>('#tdLayerPicker button').forEach((b) => {
            b.classList.toggle('ink-active', b.dataset.iso === partId)
          })
          if (engine) updateBadge(engine)
        },
        onUserInteract: stopTour
      })
    } catch {
      stage.innerHTML = `<div style="padding:2rem;text-align:center;font-family:var(--font-mono);font-size:0.78rem;color:hsl(var(--muted-foreground))">WebGL 3D 上下文不可用，请启用硬件加速查看 3D 拆解机台。</div>`
    }

    if (engine) {
      const eng = engine

      // Architecture toggle (GPU <-> NPU)
      const setArchUi = (arch: ArchMode) => {
        eng.setArch(arch)
        document.querySelectorAll<HTMLButtonElement>('#tdArchSwitch button').forEach((b) => {
          b.classList.toggle('active', b.dataset.arch === arch)
        })
        const st = eng.getState()
        updateArchBanner(arch, st.precision)
        updateBadge(eng)
      }
      document.querySelectorAll<HTMLButtonElement>('#tdArchSwitch button').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.isTrusted) stopTour()
          setArchUi((btn.dataset.arch as ArchMode) || 'gpu')
        })
      })

      // Precision toggle (FP8 / BF16 / FP32)
      document.querySelectorAll<HTMLButtonElement>('#tdPrecGroup button').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.isTrusted) stopTour()
          const prec = (btn.dataset.prec as PrecisionMode) || 'bf16'
          eng.setPrecision(prec)
          document.querySelectorAll<HTMLButtonElement>('#tdPrecGroup button').forEach((b) => {
            b.classList.toggle('active', b === btn)
          })
          updateArchBanner(eng.getState().arch, prec)
        })
      })

      // Workload buttons
      document.querySelectorAll<HTMLButtonElement>('#tdWorkloads button').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.isTrusted) stopTour()
          eng.setWorkload((btn.dataset.wl as WorkloadMode) || 'prefill')
          document.querySelectorAll<HTMLButtonElement>('#tdWorkloads button').forEach((b) => {
            b.classList.toggle('active', b === btn)
          })
        })
      })

      // Cutaway buttons
      document.querySelectorAll<HTMLButtonElement>('#tdCutaways button').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.isTrusted) stopTour()
          const cut = (btn.dataset.cut as CutawayMode) || 'cutaway'
          eng.setCutaway(cut)
          document.querySelectorAll<HTMLButtonElement>('#tdCutaways button').forEach((b) => {
            b.classList.toggle('ink-active', b === btn)
          })
          const pct = eng.getState().explodePct
          explodeSlider.value = String(pct)
          explodeValEl.textContent = `${pct}%`
          updateBadge(eng)
        })
      })

      // Camera preset buttons
      document.querySelectorAll<HTMLButtonElement>('#tdCams button').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.isTrusted) stopTour()
          const cam = (btn.dataset.cam as CameraPreset) || 'hero'
          eng.setCameraPreset(cam)
          document.querySelectorAll<HTMLButtonElement>('#tdCams button').forEach((b) => {
            b.classList.toggle('ink-active', b === btn)
          })
          // On top-down FLOORPLAN, reveal full silicon die transparently if cold plate is solid/half-cut
          if (cam === 'floorplan') {
            const cur = eng.getState().cutaway
            if (cur === 'assembled' || cur === 'cutaway') {
              eng.setCutaway('xray')
              document.querySelectorAll<HTMLButtonElement>('#tdCutaways button').forEach((b) => {
                b.classList.toggle('ink-active', b.dataset.cut === 'xray')
              })
              updateBadge(eng)
            }
          }
        })
      })

      // Subsystem isolation bar
      document.querySelectorAll<HTMLButtonElement>('#tdLayerPicker button').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.isTrusted) stopTour()
          const iso = (btn.dataset.iso as PartId) || 'ALL'
          eng.setIsolate(iso)
          document.querySelectorAll<HTMLButtonElement>('#tdLayerPicker button').forEach((b) => {
            b.classList.toggle('ink-active', b === btn)
          })
          if (iso !== 'ALL' && eng.getState().cutaway === 'exploded') {
            document.querySelectorAll<HTMLButtonElement>('#tdCutaways button').forEach((b) => {
              b.classList.toggle('ink-active', b.dataset.cut === 'exploded')
            })
            explodeSlider.value = '100'
            explodeValEl.textContent = '100%'
          }
          updateBadge(eng)
        })
      })

      // Transport & sliders
      pauseBtn.addEventListener('click', (e) => {
        if (e.isTrusted) stopTour()
        const nextPaused = !eng.getState().paused
        eng.setPaused(nextPaused)
        pauseBtn.textContent = nextPaused ? '▶ RUN' : '❚❚ PAUSE'
        pauseBtn.classList.toggle('active', !nextPaused)
      })
      document.getElementById('tdStepBack')!.addEventListener('click', (e) => {
        if (e.isTrusted) stopTour()
        eng.stepCycle(-6)
        pauseBtn.textContent = '▶ RUN'
        pauseBtn.classList.remove('active')
      })
      document.getElementById('tdStepFwd')!.addEventListener('click', (e) => {
        if (e.isTrusted) stopTour()
        eng.stepCycle(6)
        pauseBtn.textContent = '▶ RUN'
        pauseBtn.classList.remove('active')
      })
      batchSlider.addEventListener('input', () => {
        stopTour()
        const b = Number(batchSlider.value)
        eng.setBatch(b)
        batchValEl.textContent = String(b)
      })
      explodeSlider.addEventListener('input', () => {
        stopTour()
        const v = Number(explodeSlider.value)
        eng.setExplode(v / 100)
        explodeValEl.textContent = `${v}%`
      })

      // Overlays & blog layer deep-link
      calloutToggle.addEventListener('click', (e) => {
        if (e.isTrusted) stopTour()
        calloutsOn = !calloutsOn
        eng.setCallouts(calloutsOn)
        calloutToggle.textContent = calloutsOn ? 'CALLOUTS: ON' : 'CALLOUTS: OFF'
        calloutToggle.classList.toggle('ink-active', calloutsOn)
      })
      haloToggle.addEventListener('click', (e) => {
        if (e.isTrusted) stopTour()
        haloOn = !haloOn
        eng.setHalo(haloOn)
        haloToggle.textContent = haloOn ? 'HALO: ON' : 'HALO: OFF'
        haloToggle.classList.toggle('ink-active', haloOn)
      })
      document.getElementById('tdFilterJump')!.addEventListener('click', () => {
        stopTour()
        const s = eng.getState()
        const targetLayer =
          s.isolate !== 'ALL' ? PART_CATALOG[s.arch][s.isolate].blogLayer : s.workload === 'decode' ? 'systems' : 'training'
        window.dispatchEvent(new CustomEvent('stack:change', { detail: { layer: targetLayer } }))
        document.getElementById('writing')?.scrollIntoView({ behavior: 'smooth' })
      })

      // Choreographed Auto-Tour showing GPU Half-Cut -> Exploded -> Decode -> NPU Floorplan -> FlashAttn X-Ray
      const tourScript = [
        { sel: '[data-cut="exploded"]', hold: 3400 },
        { sel: '[data-wl="decode"]', hold: 3100 },
        { sel: '[data-arch="npu"]', hold: 2200 },
        { sel: '[data-cam="floorplan"]', hold: 3200 },
        { sel: '[data-wl="flashattn"]', hold: 2800 },
        { sel: '[data-cut="xray"]', hold: 2400 },
        { sel: '[data-cam="hero"]', hold: 2800 },
        { sel: '[data-arch="gpu"]', hold: 2000 },
        { sel: '[data-wl="prefill"]', hold: 2000 },
        { sel: '[data-cut="cutaway"]', hold: 3600 }
      ]

      const moveCursorTo = (el: HTMLElement | null) => {
        if (!el) return
        const sr = shell.getBoundingClientRect()
        const er = el.getBoundingClientRect()
        const x = er.left - sr.left + er.width * 0.5
        const y = er.top - sr.top + er.height * 0.5
        cursorEl.style.opacity = '1'
        cursorEl.style.transform = `translate(${x}px, ${y}px)`
        setTimeout(() => {
          if (!autoTour) return
          ringEl.style.left = `${x}px`
          ringEl.style.top = `${y}px`
          ringEl.classList.remove('pop')
          void ringEl.offsetWidth
          ringEl.classList.add('pop')
          el.click()
        }, 560)
      }

      const nextTourStep = () => {
        if (!autoTour) return
        const step = tourScript[tourStep % tourScript.length]
        tourStep++
        moveCursorTo(shell.querySelector<HTMLElement>(step.sel))
        tourTimer = window.setTimeout(nextTourStep, step.hold)
      }

      tourChip.addEventListener('click', () => {
        if (autoTour) {
          stopTour()
        } else {
          autoTour = true
          tourChip.classList.add('on')
          tourText.textContent = 'AUTO TOUR · TAKE OVER'
          nextTourStep()
        }
      })

      if (autoTour) {
        tourTimer = window.setTimeout(nextTourStep, 2600)
      } else {
        tourChip.classList.remove('on')
        tourText.textContent = 'REDUCED MOTION · MANUAL'
      }
      window.addEventListener('beforeunload', () => eng.dispose())
      }
    }

    const benchObs = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          benchObs.disconnect()
          void bootBench()
        }
      },
      { rootMargin: '250px 0px' }
    )
    benchObs.observe(shell)
  }
</script>

