---
import type { CollectionEntry } from 'astro:content'

import PixelMouse from '@/components/brand/PixelMouse.astro'
import { ALL_LAYERS, layerColor, SERIES, sourceLabel } from '@/data/stack'

interface Props {
  posts: CollectionEntry<'blog'>[]
  /** Rows per page; "View more" reveals the next page. 0 shows everything. */
  limit?: number
  id?: string
}

const { posts, limit = 0, id = 'writing-index' } = Astro.props
const counts = Object.fromEntries(
  ALL_LAYERS.map((l) => [l.id, posts.filter((p) => p.data.layer === l.id).length])
)
const isoDate = (d: Date) => d.toISOString().slice(0, 10)
const seriesOf = (pid: string) =>
  SERIES.find((s) => (s.slugs as readonly string[]).includes(pid))?.title
const shortLayer = (l: string) => {
  const L = ALL_LAYERS.find((x) => x.id === l)
  return L && L.code ? `${L.code} ${L.name}` : 'NOTES'
}
---

<div class='windex' id={id} data-limit={limit}>
  <div class='filters'>
    <div class='chips' role='group' aria-label='按栈层筛选'>
      <button class='chip-btn' type='button' data-layer='all' aria-pressed='true'>All</button>
      {
        ALL_LAYERS.filter((l) => counts[l.id] > 0).map((l) => (
          <button class='chip-btn' type='button' data-layer={l.id} aria-pressed='false'>
            <span class='sq-dot' style={`background:${l.color}`} aria-hidden='true' />
            {l.code ? `${l.code} ${l.name}` : 'Notes'}
          </button>
        ))
      }
    </div>
    <div class='filter-right'>
      <button class='search-toggle' type='button' aria-label='搜索标题和摘要' aria-expanded='false'>
        <svg viewBox='0 0 24 24' width='13' height='13' aria-hidden='true'
          ><circle cx='11' cy='11' r='7' fill='none' stroke='currentColor' stroke-width='2'
          ></circle><path d='M20 20l-3.5-3.5' stroke='currentColor' stroke-width='2' fill='none'
          ></path></svg
        >
      </button>
      <label class='search' hidden>
        <span class='sr-only'>按标题或摘要过滤</span>
        <input type='search' placeholder='Filter titles / keywords...' autocomplete='off' id={`${id}-q`} />
      </label>
    </div>
  </div>

  <ul class='table'>
    {
      posts.map((p) => {
        const right = seriesOf(p.id) ?? sourceLabel(p.data.source)
        const c = layerColor(p.data.layer)
        return (
          <li
            data-layer={p.data.layer}
            data-q={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')} ${sourceLabel(p.data.source)}`.toLowerCase()}
          >
            <a class='trow' href={`/blog/${p.id}`} style={`--row-c:${c}`}>
              <span class='art-date mono'>{isoDate(p.data.publishDate)}</span>
              <span class='art-layer mono'>
                <span class='sq-dot' style={`background:${c}`} aria-hidden='true' />
                {shortLayer(p.data.layer)}
              </span>
              <span class='ttl'>
                <span class='t'>{p.data.title}</span>
                <span class='x'>{p.data.description}</span>
              </span>
              <span class='who mono'>{right}</span>
            </a>
          </li>
        )
      })
    }
    <li class='empty' hidden>
      <PixelMouse variant='puzzled' px={2} label='' />
      <span>没有匹配的文章。换个关键词，或者点 ALL 清除筛选。</span>
    </li>
  </ul>

  <div class='foot'>
    <button class='more mono' type='button' hidden>View more</button>
    <span class='shown mono'>{posts.length} posts</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.windex').forEach((root) => {
    const step = Number(root.dataset.limit || 0)
    const rows = Array.from(root.querySelectorAll<HTMLLIElement>('li[data-layer]'))
    const empty = root.querySelector<HTMLLIElement>('li.empty')!
    const shown = root.querySelector<HTMLElement>('.shown')!
    const more = root.querySelector<HTMLButtonElement>('.more')!
    const toggle = root.querySelector<HTMLButtonElement>('.search-toggle')!
    const search = root.querySelector<HTMLLabelElement>('.search')!
    const input = search.querySelector('input')!
    let layer = 'all'
    let q = ''
    let cap = step || Infinity

    const render = () => {
      const match = rows.filter(
        (r) => (layer === 'all' || r.dataset.layer === layer) && (!q || r.dataset.q!.includes(q))
      )
      rows.forEach((r) => (r.hidden = true))
      match.forEach((r, i) => (r.hidden = i >= cap))
      empty.hidden = match.length > 0
      const visible = Math.min(match.length, cap)
      shown.textContent =
        visible === match.length ? `${match.length} posts` : `${visible} / ${match.length}`
      more.hidden = visible >= match.length
      root.querySelectorAll<HTMLButtonElement>('.chip-btn').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.layer === layer))
      })
    }

    root.querySelector('.chips')?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.chip-btn')
      if (b) document.dispatchEvent(new CustomEvent('stack:change', { detail: b.dataset.layer }))
    })
    document.addEventListener('stack:change', (e) => {
      layer = (e as CustomEvent<string>).detail || 'all'
      cap = step || Infinity
      render()
    })
    toggle.addEventListener('click', () => {
      const open = search.hidden
      search.hidden = !open
      toggle.setAttribute('aria-expanded', String(open))
      if (open) input.focus()
      else if (q) {
        input.value = ''
        q = ''
        render()
      }
    })
    input.addEventListener('input', () => {
      q = input.value.trim().toLowerCase()
      cap = step || Infinity
      render()
    })
    more.addEventListener('click', () => {
      cap += step || Infinity
      render()
    })

    // Deep link: /blog?layer=systems
    const fromUrl = new URLSearchParams(location.search).get('layer')
    if (fromUrl) document.dispatchEvent(new CustomEvent('stack:change', { detail: fromUrl }))
    else render()
  })
</script>

<style>
  .windex [hidden] {
    display: none !important;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.65rem 0.85rem;
    margin-bottom: 0.25rem;
    background: hsl(var(--card));
    border: 1.5px solid var(--ink-hard, #171716);
  }
  .filter-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .search-toggle,
  .chip-btn,
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    padding: 0.26rem 0.55rem;
    cursor: pointer;
    line-height: 1.3;
  }
  .search-toggle {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chip-btn:hover,
  .search-toggle:hover,
  .more:hover {
    border-color: var(--ink-hard, #171716);
    color: hsl(var(--foreground));
  }
  .chip-btn[aria-pressed='true'] {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    border-color: hsl(var(--foreground));
  }
  .search input {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    width: 13rem;
    max-width: 60vw;
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    padding: 0.28rem 0.55rem;
    outline: none;
  }
  .search input:focus {
    border-color: var(--ink-hard, #171716);
  }
  .table {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1.5px solid var(--ink-hard, #171716);
  }
  .trow {
    display: grid;
    grid-template-columns: 5.8rem 6.75rem minmax(0, 1fr) 10.5rem;
    gap: 1.15rem;
    align-items: baseline;
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.14s ease,
      box-shadow 0.14s ease;
  }
  .trow:hover {
    background: hsl(var(--card));
    box-shadow: inset 3px 0 0 var(--row-c, var(--c-l6));
    color: inherit;
  }
  .trow:hover .t {
    color: hsl(var(--primary));
  }
  .art-date {
    font-size: 0.72rem;
    color: hsl(var(--faint));
    white-space: nowrap;
  }
  .art-layer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }
  .who {
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: hsl(var(--faint));
    white-space: nowrap;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ttl {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .t {
    color: hsl(var(--foreground));
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.42;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }
  .x {
    display: block;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .empty {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0.75rem;
    color: hsl(var(--muted-foreground));
    border-bottom: 1px solid hsl(var(--border));
  }
  .foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .more {
    padding: 0.45rem 1.05rem;
    font-size: 0.72rem;
    border: 1.5px solid var(--ink-hard, #171716);
    color: hsl(var(--foreground));
  }
  .shown {
    font-size: 0.7rem;
    color: hsl(var(--faint));
  }
  @media (max-width: 860px) {
    .trow {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.22rem;
      padding: 0.85rem 0.5rem;
    }
    .who {
      display: none;
    }
    .t {
      white-space: normal;
    }
    .x {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
