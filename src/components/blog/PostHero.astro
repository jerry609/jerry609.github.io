---
import type { CollectionEntry } from 'astro:content'

import { LAYERS, layerLabel, SERIES, sourceLabel } from '@/data/stack'
import type { Cover } from '@/utils/cover'

interface Props {
  post: CollectionEntry<'blog'>
  cover: Cover
  minutesRead?: unknown
}

const { post, cover, minutesRead } = Astro.props
const { title, description, publishDate, updatedDate, layer, source, draft } = post.data
const MONTHS = ['JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE', 'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER']
const long = (d: Date) => `${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`
const series = SERIES.find((s) => (s.slugs as readonly string[]).includes(post.id))
const pos = series ? (series.slugs as readonly string[]).indexOf(post.id) + 1 : 0
const lit = LAYERS.findIndex((l) => l.id === layer)
// Bottom plate first so the DOM order matches the stacking order
const plates = [...LAYERS].reverse().map((l, i) => ({ ...l, i, on: l.id === layer }))
---

<header class='phero' data-dark-hero>
  <div class='bg' aria-hidden='true'></div>

  <div class='scene' aria-hidden='true'>
    <div class:list={['iso', lit < 0 && 'iso-notes']}>
      {
        plates.map((p) => (
          <div class:list={['plate', p.on && 'on']} style={`--i:${p.i}`}>
            <span class='pl-code'>{p.code}</span>
            <span class='pl-name'>{p.name}</span>
            {p.on && <span class='pl-label'>{cover.label}</span>}
          </div>
        ))
      }
    </div>
  </div>

  <div class='txt'>
    <p class='kicker mono'>
      <a href={`/blog?layer=${layer}`}>{layerLabel(layer)}</a>
      {
        series && (
          <a href='#series-nav'>
            {series.title} · {pos}/{series.slugs.length}
          </a>
        )
      }
      {draft && <span class='draft'>Draft</span>}
    </p>
    <h1>{title}</h1>
    {description && <p class='dek'>{description}</p>}
    <p class='meta mono'>
      <time datetime={publishDate.toISOString()}>{long(publishDate)}</time>
      {updatedDate && <span>Updated {long(updatedDate)}</span>}
      {minutesRead && <span>{String(minutesRead).toUpperCase()}</span>}
      {
        source &&
          (source.url ? (
            <a href={source.url} target='_blank' rel='noopener' title={source.title}>
              {sourceLabel(source)} ↗
            </a>
          ) : (
            <span>{sourceLabel(source)}</span>
          ))
      }
      <button type='button' class='copy' data-copy-link>Copy link</button>
    </p>
  </div>
</header>

<script>
  const hero = document.querySelector<HTMLElement>('.phero')
  if (hero) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const update = () => {
      const h = hero.offsetHeight
      const p = Math.min(1, Math.max(0, window.scrollY / (h * 0.85)))
      hero.style.setProperty('--p', p.toFixed(3))
    }
    if (!reduce) {
      update()
      window.addEventListener('scroll', update, { passive: true })
    }
    hero.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      try {
        await navigator.clipboard.writeText(location.href.split('#')[0])
        btn.textContent = 'Copied'
      } catch {
        btn.textContent = location.href.split('#')[0]
      }
      setTimeout(() => (btn.textContent = 'Copy link'), 1800)
    })
  }
</script>

<style>
  .phero {
    --p: 0;
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: -5rem;
    min-height: min(88svh, 860px);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    color: #e6e9ec;
    isolation: isolate;
  }
  /* Night asphalt: dark ground, fine grid, grain, vignette (fixed in both themes) */
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 80% at 50% 110%, rgb(255 255 255 / 0.1), transparent 60%),
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 144px 144px,
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 144px 144px,
      radial-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1.5px) 0 0 / 5px 5px,
      linear-gradient(180deg, #08090b 0%, #0f1215 45%, #2a3038 100%);
  }
  .scene {
    position: relative;
    display: grid;
    place-items: center;
    padding-top: 7.5rem;
    padding-bottom: 1rem;
    perspective: 1400px;
    opacity: calc(1 - var(--p) * 0.9);
  }
  .iso {
    position: relative;
    width: min(360px, 66vw);
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    transform: rotateX(58deg) rotateZ(-36deg) translateY(calc(var(--p) * -40px));
  }
  .plate {
    --gap: calc(30px + var(--p) * 46px);
    position: absolute;
    inset: 0;
    transform: translateZ(calc(var(--i) * var(--gap)));
    border: 1px solid rgb(255 255 255 / 0.22);
    background:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 100% 12.5%,
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 8.333% 100%,
      rgb(15 18 21 / 0.82);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.4);
    transition: transform 0.1s linear;
  }
  .plate.on {
    transform: translateZ(calc(var(--i) * var(--gap) + 34px + var(--p) * 40px));
    border-color: #f08a4b;
    background:
      linear-gradient(rgb(240 138 75 / 0.18) 1px, transparent 1px) 0 0 / 100% 12.5%,
      linear-gradient(90deg, rgb(240 138 75 / 0.18) 1px, transparent 1px) 0 0 / 8.333% 100%,
      rgb(212 101 42 / 0.22);
    box-shadow:
      0 0 40px rgb(240 138 75 / 0.35),
      0 0 0 1px rgb(240 138 75 / 0.6);
  }
  .pl-code,
  .pl-name {
    position: absolute;
    top: 8%;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgb(255 255 255 / 0.55);
  }
  .pl-code {
    left: 5%;
  }
  .pl-name {
    left: 16%;
    text-transform: uppercase;
  }
  .plate.on .pl-code,
  .plate.on .pl-name {
    color: #f4a06a;
  }
  .pl-label {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 8%;
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: clamp(26px, 5vw, 48px);
    line-height: 1;
    color: #fff;
    overflow-wrap: anywhere;
    text-shadow: 0 0 18px rgb(240 138 75 / 0.6);
  }
  .txt {
    position: relative;
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3.5rem;
    text-align: center;
    transform: translateY(calc(var(--p) * -24px));
    opacity: calc(1 - var(--p) * 1.4);
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .kicker a {
    color: #f4a06a;
    text-decoration: none;
  }
  .kicker a + a {
    color: rgb(230 233 236 / 0.7);
  }
  .kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .draft {
    color: #f2756a;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 5.2vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #f3f5f7;
    text-wrap: balance;
  }
  .dek {
    max-width: 38rem;
    margin: 1.25rem auto 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgb(230 233 236 / 0.82);
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 1.25rem;
    margin: 1.6rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(230 233 236 / 0.62);
  }
  .meta a {
    color: rgb(230 233 236 / 0.85);
    text-decoration: underline;
    text-decoration-color: rgb(240 138 75 / 0.7);
    text-underline-offset: 3px;
  }
  .copy {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: #e6e9ec;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 2px;
    padding: 0.15rem 0.5rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: #f08a4b;
  }
  @media (max-width: 640px) {
    .phero {
      margin-top: -4.5rem;
      min-height: auto;
    }
    .scene {
      padding-top: 5rem;
      padding-bottom: 0.5rem;
    }
    .iso {
      width: 64vw;
    }
    .plate {
      --gap: calc(18px + var(--p) * 24px);
    }
    .pl-code,
    .pl-name {
      font-size: 8px;
    }
    .txt {
      padding-bottom: 2.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate {
      transition: none;
    }
  }
</style>
