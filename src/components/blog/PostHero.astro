---
import type { CollectionEntry } from 'astro:content'

import { LAYERS, layerColor, layerLabel, SERIES, sourceLabel } from '@/data/stack'
import type { Cover } from '@/utils/cover'

interface Props {
  post: CollectionEntry<'blog'>
  cover: Cover
  minutesRead?: unknown
}

const { post, cover, minutesRead } = Astro.props
const { title, description, publishDate, updatedDate, layer, source, draft } = post.data
const iso = (d: Date) => d.toISOString().slice(0, 10)
const series = SERIES.find((s) => (s.slugs as readonly string[]).includes(post.id))
const pos = series ? (series.slugs as readonly string[]).indexOf(post.id) + 1 : 0
const accent = layerColor(layer)
---

<header class='phero' style={`--layer-c:${accent}`}>
  <div class='phero-grid'>
    <div class='phero-main'>
      <div class='crumb mono'>
        <div class='crumb-path'>
          <a href='/'>HOME</a>
          <span>/</span>
          <a href='/blog'>WRITING</a>
          <span>/</span>
          <a class='crumb-layer' href={`/blog?layer=${layer}`}>
            <span class='sq-dot' style={`background:${accent}`} aria-hidden='true' />
            {layerLabel(layer)}
          </a>
          {
            series && (
              <>
                <span>/</span>
                <a href='#series-nav'>
                  {series.title} ({pos}/{series.slugs.length})
                </a>
              </>
            )
          }
          {draft && <span class='draft'>DRAFT</span>}
        </div>
      </div>

      <h1>{title}</h1>
      {description && <p class='dek'>{description}</p>}

      <div class='meta-strip mono'>
        <div class='meta-items'>
          <span>PUBLISHED <strong>{iso(publishDate)}</strong></span>
          {updatedDate && <span>UPDATED <strong>{iso(updatedDate)}</strong></span>}
          {minutesRead && <span>READ <strong>{String(minutesRead).toUpperCase()}</strong></span>}
          {
            source &&
              (source.url ? (
                <a href={source.url} target='_blank' rel='noopener' title={source.title}>
                  {sourceLabel(source)} ↗
                </a>
              ) : (
                <span>{sourceLabel(source)}</span>
              ))
          }
        </div>
        <button type='button' class='copy' data-copy-link>COPY LINK</button>
      </div>
    </div>

    <!-- Compact architectural 6-layer stack indicator (replaces bulky 100vh dark hero) -->
    <aside class='phero-plate' aria-hidden='true'>
      <div class='plate-head mono'>
        <span>STACK LAYER</span>
        <span style={`color:${accent}`}>{cover.label}</span>
      </div>
      <div class='plate-stack'>
        {
          LAYERS.map((l) => {
            const on = l.id === layer
            return (
              <div class:list={['plate-row mono', on && 'on']} style={`--pc:${l.color}`}>
                <span class='p-sq' />
                <span class='p-code'>{l.code}</span>
                <span class='p-name'>{l.name}</span>
                {on && <span class='p-mark'>ACTIVE</span>}
              </div>
            )
          })
        }
      </div>
    </aside>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]')
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0])
      btn.textContent = 'COPIED ✓'
    } catch {
      btn.textContent = 'COPY FAILED'
    }
    setTimeout(() => (btn.textContent = 'COPY LINK'), 1600)
  })
</script>

<style>
  .phero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: -1.5rem;
    padding: 2.25rem max(1.75rem, calc((100vw - 72rem) / 2 + 1.75rem)) 2rem;
    background: hsl(var(--card));
    border-bottom: 1.5px solid var(--ink-hard, #171716);
  }
  .phero-grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 232px;
    gap: 2.25rem;
    align-items: start;
  }
  .crumb {
    margin-bottom: 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .crumb-path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.55rem;
  }
  .crumb a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }
  .crumb a:hover {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .crumb-layer {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: hsl(var(--foreground)) !important;
    font-weight: 500;
  }
  .draft {
    color: var(--c-l6);
    font-weight: 600;
  }
  h1 {
    margin: 0 0 0.85rem;
    font-family: var(--font-body);
    font-size: clamp(1.85rem, 3.2vw, 2.7rem);
    font-weight: 400;
    letter-spacing: -0.028em;
    line-height: 1.2;
    color: hsl(var(--foreground));
    text-wrap: balance;
  }
  .dek {
    margin: 0 0 1.35rem;
    max-width: 66ch;
    font-size: 0.98rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
  }
  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding-top: 0.95rem;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: hsl(var(--faint));
  }
  .meta-items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 1.25rem;
  }
  .meta-items strong {
    color: hsl(var(--foreground));
    font-weight: 500;
  }
  .meta-items a {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-color: var(--layer-c, var(--c-l6));
    text-underline-offset: 3px;
  }
  .copy {
    font: inherit;
    letter-spacing: 0.08em;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
    border: 1px solid var(--ink-hard, #171716);
    border-radius: 2px;
    padding: 0.28rem 0.65rem;
    cursor: pointer;
  }
  .copy:hover {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  /* Compact right obsidian stack indicator */
  .phero-plate {
    background: #1d1d1d;
    color: #f0f0ef;
    border: 1.5px solid #020100;
    padding: 0.75rem;
  }
  .plate-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: #9a9a97;
    padding-bottom: 0.5rem;
    margin-bottom: 0.45rem;
    border-bottom: 1px solid #30302e;
    white-space: nowrap;
    overflow: hidden;
  }
  .plate-stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .plate-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    font-size: 0.62rem;
    color: #7c7c78;
    background: #171716;
    border: 1px solid #292927;
  }
  .p-sq {
    width: 6px;
    height: 6px;
    background: var(--pc);
    opacity: 0.45;
  }
  .plate-row.on {
    color: #ffffff;
    background: #262624;
    border-color: var(--pc);
    box-shadow: inset 2px 0 0 var(--pc);
  }
  .plate-row.on .p-sq {
    opacity: 1;
  }
  .p-code {
    width: 1.25rem;
  }
  .p-mark {
    margin-left: auto;
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    color: var(--pc);
  }

  @media (max-width: 920px) {
    .phero {
      padding: 1.75rem 1.25rem 1.5rem;
    }
    .phero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .phero-plate {
      display: none;
    }
  }
</style>
