---
import config from 'virtual:config'

import { Icon } from 'astro-pure/user'
import PixelMouse from '@/components/brand/PixelMouse.astro'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (link: string) => path === link || path.startsWith(link + '/')

const elsewhere = [
  { title: '友链', link: '/links' },
  { title: '归档', link: '/archives' },
  { title: '标签', link: '/tags' }
]
---

<site-header class='site-header'>
  <div class='site-wrap site-header-inner'>
    <a class='brand' href='/' aria-label='Jerry Zhang 首页'>
      <PixelMouse crop='head' px={2} label='' class='brand-mark' />
      <span class='wordmark'>jerry609</span>
    </a>

    <nav class='nav' aria-label='主导航'>
      {
        config.header.menu.map((item) => (
          <a href={item.link} aria-current={isActive(item.link) ? 'page' : undefined}>
            {item.title}
          </a>
        ))
      }
    </nav>

    <div class='actions'>
      <a class='icon-btn search-btn' href='/search' title='搜索 (⌘K)'>
        <Icon name='search' class='size-4' />
        <span class='label'>搜索</span>
        <kbd>⌘K</kbd>
      </a>
      <button class='icon-btn' id='themeToggle' type='button' title='切换主题' data-theme='system'>
        <span class='sr-only'>切换主题</span>
        <Icon class='t-system size-4' name='computer' />
        <Icon class='t-light size-4' name='sun' />
        <Icon class='t-dark size-4' name='moon' />
      </button>
      <button
        class='icon-btn menu-btn'
        id='menuToggle'
        type='button'
        aria-expanded='false'
        aria-controls='mobileMenu'
      >
        <span class='sr-only'>菜单</span>
        <Icon class='size-4' name='menu' />
      </button>
    </div>
  </div>

  <div class='mobile-menu' id='mobileMenu' hidden>
    <div class='site-wrap mobile-menu-inner'>
      {
        config.header.menu.map((item) => (
          <a href={item.link} aria-current={isActive(item.link) ? 'page' : undefined}>
            {item.title}
          </a>
        ))
      }
      <span class='mobile-sep mono'>其他</span>
      {elsewhere.map((item) => <a href={item.link}>{item.title}</a>)}
    </div>
  </div>
</site-header>

<script is:inline>
  ;(function () {
    var el = document.getElementById('themeToggle')
    if (el) el.dataset.theme = localStorage.getItem('theme') || 'system'
  })()
</script>

<script>
  import { setTheme } from 'astro-pure/utils'

  const labels: Record<string, string> = { system: '跟随系统', dark: '暗色', light: '亮色' }

  class SiteHeader extends HTMLElement {
    connectedCallback() {
      // Over a dark post hero the header goes transparent with light text
      const hero = document.querySelector<HTMLElement>('[data-dark-hero]')
      const onScroll = () => {
        this.classList.toggle('scrolled', window.scrollY > 8)
        if (hero) this.classList.toggle('on-dark', hero.getBoundingClientRect().bottom > this.offsetHeight)
      }
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })

      const themeBtn = this.querySelector('#themeToggle') as HTMLButtonElement
      themeBtn.title = `主题：${labels[themeBtn.dataset.theme || 'system']}`
      themeBtn.addEventListener('click', () => {
        const next = setTheme(undefined, true) || 'system'
        themeBtn.dataset.theme = next
        themeBtn.title = `主题：${labels[next]}`
      })

      const menuBtn = this.querySelector('#menuToggle') as HTMLButtonElement
      const menu = this.querySelector('#mobileMenu') as HTMLElement
      menuBtn.addEventListener('click', () => {
        const open = menu.hidden
        menu.hidden = !open
        menuBtn.setAttribute('aria-expanded', String(open))
      })

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault()
          window.location.href = '/search'
        }
      })
    }
  }
  customElements.define('site-header', SiteHeader)
</script>

<style>
  .site-header {
    display: block;
    position: sticky;
    top: 0;
    z-index: 50;
    background: hsl(var(--background) / 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid hsl(var(--border));
    transition: border-color 0.2s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--ink-hard, hsl(var(--border)));
  }
  .site-header.on-dark {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: #e6e9ec;
  }
  .site-header.on-dark .brand,
  .site-header.on-dark .nav a[aria-current='page'] {
    color: #f3f5f7;
  }
  .site-header.on-dark .nav a {
    color: rgb(230 233 236 / 0.72);
  }
  .site-header.on-dark .nav a:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
  }
  .site-header.on-dark .icon-btn {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.22);
    color: #e6e9ec;
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 3.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: hsl(var(--foreground));
  }
  .brand:hover {
    color: hsl(var(--foreground));
  }
  .brand:hover .wordmark {
    color: hsl(var(--primary));
  }
  .wordmark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }
  .nav {
    display: flex;
    gap: 0.25rem;
    margin-left: 0.5rem;
  }
  .nav a,
  .mobile-menu a {
    text-decoration: none;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius);
  }
  .nav a:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
  }
  .nav a[aria-current='page'],
  .mobile-menu a[aria-current='page'] {
    color: hsl(var(--foreground));
    box-shadow: inset 0 -2px 0 hsl(var(--scarf));
    border-radius: 0;
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    min-width: 2rem;
    justify-content: center;
    padding: 0 0.5rem;
    border: var(--hair) solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
    color: hsl(var(--muted-foreground));
    font: inherit;
    font-size: 0.82rem;
    text-decoration: none;
    cursor: pointer;
  }
  .icon-btn:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--faint));
  }
  .search-btn {
    padding: 0 0.6rem;
  }
  .search-btn kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: hsl(var(--faint));
  }
  #themeToggle :global(svg) {
    display: none;
  }
  #themeToggle[data-theme='system'] :global(.t-system),
  #themeToggle[data-theme='light'] :global(.t-light),
  #themeToggle[data-theme='dark'] :global(.t-dark) {
    display: block;
  }
  .menu-btn {
    display: none;
  }
  .mobile-menu {
    border-top: var(--hair) solid hsl(var(--border));
    background: hsl(var(--background));
  }
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem 1rem;
  }
  .mobile-menu a {
    padding: 0.6rem 0;
    font-size: 1rem;
  }
  .mobile-menu a[aria-current='page'] {
    box-shadow: inset 2px 0 0 hsl(var(--scarf));
    padding-left: 0.75rem;
  }
  .mobile-sep {
    color: hsl(var(--faint));
    padding: 0.75rem 0 0.25rem;
    border-top: var(--hair) solid hsl(var(--border));
    margin-top: 0.5rem;
  }
  @media (max-width: 720px) {
    .nav,
    .search-btn .label,
    .search-btn kbd {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
</style>
