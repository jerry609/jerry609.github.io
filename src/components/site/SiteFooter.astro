---
import PixelMouse from '@/components/brand/PixelMouse.astro'

const year = new Date().getFullYear()

const groups = [
  {
    title: '写作',
    links: [
      { title: '全部文章', link: '/blog' },
      { title: '归档', link: '/archives' },
      { title: '标签', link: '/tags' },
      { title: '数学笔记', link: '/math-notes' }
    ]
  },
  {
    title: '其他角落',
    links: [
      { title: '碎碎念', link: '/murmurs' },
      { title: '照片', link: '/photos' },
      { title: '友链', link: '/links' },
      { title: '算法路线', link: '/roadmap' }
    ]
  },
  {
    title: '找到我',
    links: [
      { title: 'GitHub', link: 'https://github.com/jerry609' },
      { title: 'RSS', link: '/rss.xml' }
    ]
  }
]
---

<footer class='site-footer'>
  <div class='site-wrap footer-inner'>
    <div class='footer-id'>
      <a class='footer-brand' href='/'>
        <PixelMouse variant='sleeping' px={2} label='' />
        <span>jerry609</span>
      </a>
      <p>Agent × Infra 全栈研究笔记。</p>
      <p class='motto'>如其所是</p>
    </div>
    {
      groups.map((g) => (
        <div class='footer-group'>
          <h2 class='mono'>{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a
                  href={l.link}
                  {...(l.link.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {l.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class='site-wrap footer-base mono'>
    <span>© {year} Jerry Zhang</span>
    <span>Built with Astro</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: var(--hair) solid hsl(var(--border));
  }
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 2.5rem 2rem;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: 1.35rem;
    text-decoration: none;
    color: hsl(var(--foreground));
  }
  .footer-id p {
    margin: 0.5rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
  }
  .footer-id .motto {
    color: hsl(var(--faint));
  }
  .footer-group h2 {
    margin: 0 0 0.75rem;
    font-weight: 500;
    color: hsl(var(--faint));
  }
  .footer-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .footer-group a {
    text-decoration: none;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
  }
  .footer-group a:hover {
    color: hsl(var(--primary));
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 1rem 2rem;
    border-top: var(--hair) solid hsl(var(--border));
    color: hsl(var(--faint));
  }
  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .footer-id {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 460px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
