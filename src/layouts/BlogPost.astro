---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import config from 'virtual:config'

import { MediumZoom } from 'astro-pure/advanced'
import { Copyright } from 'astro-pure/components/pages'
import { cn } from 'astro-pure/utils'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostCover from '@/components/blog/PostCover.astro'
import PostHero from '@/components/blog/PostHero.astro'
import SeriesNav from '@/components/blog/SeriesNav.astro'
import { Comment } from '@/components/waline'
import { layerLabel } from '@/data/stack'
import { buildCovers } from '@/utils/cover'
import { sectionLabels, stripOwnNumber } from '@/utils/sections'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const { post, posts, headings, remarkPluginFrontmatter } = Astro.props
const { data } = post
const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  tags,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()

const covers = buildCovers(posts)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3)
const h2Headings = headings.filter((h) => h.depth === 2)
const { labels: h2Labels } = sectionLabels(h2Headings.map((h) => h.text))
let h2Idx = -1
let h3Idx = 0
const tocItems = tocHeadings.map((h) => {
  if (h.depth === 2) {
    h2Idx++
    h3Idx = 0
    return { ...h, label: h2Labels[h2Idx] ?? String(h2Idx + 1).padStart(2, '0'), sub: false }
  }
  h3Idx++
  const prefix = h2Idx >= 0 ? `${h2Idx + 1}.${h3Idx}` : `·`
  return { ...h, label: prefix, sub: true }
})

// Read next: the neighbours in time
const byDate = [...posts].sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf())
const at = byDate.findIndex((p) => p.id === post.id)
const nextUp = [byDate[at + 1], byDate[at - 1]].filter(Boolean) as CollectionEntry<'blog'>[]
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
  <PostHero {post} cover={covers.get(post.id)!} minutesRead={remarkPluginFrontmatter.minutesRead} />

  <div class:list={['post', tocItems.length < 2 && 'no-rail']}>
    {
      tocItems.length >= 2 && (
        <aside class='rail' aria-label='文章大纲与阅读进度'>
          <div class='rail-head mono'>OUTLINE · H2 + H3</div>
          <ol>
            {tocItems.map((h) => (
              <li class:list={[h.sub && 'is-sub']}>
                <a href={`#${h.slug}`} data-rail={h.slug}>
                  <span class='n'>{h.label}</span>
                  <span class='t'>{stripOwnNumber(h.text)}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class='mem-progress mono' aria-hidden='true'>
            <div class='mem-head'>MEMORY HIERARCHY</div>
            <div class='mem-tiers' id='memTiers'>
              <div class='mem-tier lit'><span>REG</span><i></i><span>25%</span></div>
              <div class='mem-tier'><span>SRAM</span><i></i><span>50%</span></div>
              <div class='mem-tier'><span>HBM3</span><i></i><span>75%</span></div>
              <div class='mem-tier'><span>NVME</span><i></i><span>END</span></div>
            </div>
          </div>
        </aside>
      )
    }

    <article class='body' data-pagefind-body={isDraft ? undefined : ''}>
      {
        tocItems.length >= 2 && (
          <details class='toc-m'>
            <summary class='mono'>目录 · {tocItems.length} 节</summary>
            <ol>
              {tocItems.map((h) => (
                <li class:list={[h.sub && 'is-sub']}>
                  <a href={`#${h.slug}`}>
                    <span class='mono'>{h.label}</span> {stripOwnNumber(h.text)}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div id='content' class={cn('post-prose max-w-none', config.integ.typography.class)}>
        <slot />
      </div>

      {
        tags.length > 0 && (
          <p class='tags'>
            {tags.map((t) => (
              <a class='chip' href={`/tags/${t}`} data-pagefind-filter='tag'>
                {t}
              </a>
            ))}
          </p>
        )
      }

      <SeriesNav {post} {posts} />

      {
        nextUp.length > 0 && (
          <section class='next' aria-label='继续读'>
            <p class='next-h mono'>Read next</p>
            <div class='next-grid'>
              {nextUp.map((p) => (
                <a class='next-card' href={`/blog/${p.id}`}>
                  <PostCover post={p} cover={covers.get(p.id)!} />
                  <span class='mono nm'>{layerLabel(p.data.layer)}</span>
                  <span class='nt'>{p.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <Copyright {data} class='copyright' />
      {!isDraft && enableComment && <Comment class='mt-6' />}
    </article>
  </div>
</BaseLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<script>
  // Mermaid fences: render as diagrams, loading the library only when a page has one
  const mermaidBlocks = Array.from(document.querySelectorAll<HTMLElement>('.astro-code[data-language="mermaid"]'))
  if (mermaidBlocks.length) {
    // Pre-bundled ESM build: keeps Vite from re-bundling mermaid's ~1k source modules
    import('mermaid/dist/mermaid.esm.min.mjs').then(async ({ default: mermaid }) => {
      const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim()
      const hsl = (v: string) => `hsl(${css(v)})`
      const dark = document.documentElement.classList.contains('dark')
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: 'Geist Variable, PingFang SC, sans-serif',
        themeVariables: {
          darkMode: dark,
          background: hsl('--card'),
          primaryColor: hsl('--card'),
          primaryBorderColor: hsl('--foreground'),
          primaryTextColor: hsl('--foreground'),
          secondaryColor: hsl('--muted'),
          tertiaryColor: hsl('--muted'),
          lineColor: hsl('--faint'),
          textColor: hsl('--foreground'),
          edgeLabelBackground: hsl('--card'),
          fontSize: '14px'
        }
      })
      for (const [i, block] of mermaidBlocks.entries()) {
        const src = Array.from(block.querySelectorAll('.line'))
          .map((l) => l.textContent ?? '')
          .join('\n')
        try {
          const { svg } = await mermaid.render(`mermaid-${i}`, src)
          const fig = document.createElement('figure')
          fig.className = 'mermaid-fig'
          fig.innerHTML = svg
          block.replaceWith(fig)
        } catch {
          // Leave the source visible if the diagram can't be parsed
        }
      }
    })
  }

  // Highlight the section being read in the left rail + update Memory-Hierarchy progress
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail]'))
  const memTiers = Array.from(document.querySelectorAll<HTMLElement>('#memTiers .mem-tier'))
  const articleEl = document.querySelector<HTMLElement>('#content')
  if (links.length || memTiers.length) {
    const targets = links
      .map((a) => document.getElementById(a.dataset.rail || ''))
      .filter(Boolean) as HTMLElement[]
    const setActive = (id: string) =>
      links.forEach((a) => a.classList.toggle('active', a.dataset.rail === id))
    const onScroll = () => {
      if (targets.length) {
        const line = window.innerHeight * 0.28
        let current = targets[0]?.id
        for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t.id
        if (current) setActive(current)
      }
      if (memTiers.length && articleEl) {
        const rect = articleEl.getBoundingClientRect()
        const total = Math.max(1, rect.height - window.innerHeight * 0.5)
        const pct = Math.max(0, Math.min(1, (-rect.top + window.innerHeight * 0.25) / total))
        const litCount = pct < 0.25 ? 1 : pct < 0.55 ? 2 : pct < 0.85 ? 3 : 4
        memTiers.forEach((el, idx) => el.classList.toggle('lit', idx < litCount))
      }
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  }
</script>

<style>
  .post {
    display: grid;
    grid-template-columns: 14.5rem minmax(0, 46rem) minmax(0, 1fr);
    gap: 2.75rem;
    margin-top: 2.5rem;
  }
  .post.no-rail {
    grid-template-columns: minmax(0, 46rem);
    justify-content: center;
  }
  .rail {
    position: sticky;
    top: 4.75rem;
    align-self: start;
    max-height: calc(100svh - 6rem);
    overflow-y: auto;
    padding-right: 1rem;
    border-right: 1px solid hsl(var(--border));
    scrollbar-width: thin;
  }
  .rail-head {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: hsl(var(--faint));
    margin-bottom: 0.75rem;
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.42rem;
  }
  .rail li.is-sub {
    padding-left: 0.85rem;
  }
  .rail a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.76rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }
  .rail li.is-sub a {
    font-size: 0.72rem;
    color: hsl(var(--faint));
  }
  .rail .n {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--c-l6, #fa6d01);
    flex-shrink: 0;
  }
  .rail .t {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .rail a:hover,
  .rail a.active {
    color: hsl(var(--foreground));
    font-weight: 500;
  }
  .mem-progress {
    margin-top: 1.35rem;
    padding-top: 0.9rem;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.58rem;
    color: hsl(var(--faint));
  }
  .mem-head {
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .mem-tiers {
    display: grid;
    gap: 5px;
  }
  .mem-tier {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mem-tier i {
    flex: 1;
    height: 3px;
    background: hsl(var(--muted));
    display: block;
  }
  .mem-tier.lit {
    color: hsl(var(--foreground));
  }
  .mem-tier.lit i {
    background: var(--c-l6, #fa6d01);
  }
  .body {
    grid-column: 2;
    min-width: 0;
  }
  .post.no-rail .body {
    grid-column: 1;
  }
  .toc-m {
    display: none;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 2.5rem 0 0;
  }
  .tags .chip {
    text-decoration: none;
  }
  .tags .chip:hover {
    color: hsl(var(--primary));
    border-color: hsl(var(--scarf) / 0.6);
  }
  .next {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: var(--hair) solid hsl(var(--border));
  }
  .next-h {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .next-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .next-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .next-card:hover {
    color: inherit;
  }
  .next-card:hover .nt {
    color: hsl(var(--primary));
  }
  .nm {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .nt {
    font-weight: 500;
    line-height: 1.45;
  }
  .body :global(.copyright) {
    margin-top: 3rem;
    border-radius: var(--radius-box);
  }
  @media (max-width: 1100px) {
    .post,
    .post.no-rail {
      grid-template-columns: minmax(0, 46rem);
      justify-content: center;
      gap: 0;
    }
    .rail {
      display: none;
    }
    .body {
      grid-column: 1;
    }
    .toc-m {
      display: block;
      margin-bottom: 2rem;
      border: var(--hair) solid hsl(var(--border));
      border-radius: var(--radius);
      background: hsl(var(--card));
    }
    .toc-m summary {
      cursor: pointer;
      padding: 0.6rem 0.9rem;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: hsl(var(--muted-foreground));
    }
    .toc-m ol {
      list-style: none;
      margin: 0;
      padding: 0 0.9rem 0.75rem;
      display: grid;
      gap: 0.35rem;
      font-size: 0.9rem;
    }
    .toc-m a {
      color: hsl(var(--foreground));
      text-decoration: none;
    }
    .toc-m .mono {
      color: hsl(var(--faint));
      margin-right: 0.4rem;
    }
  }
  @media (max-width: 560px) {
    .next-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
