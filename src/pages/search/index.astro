---
import { PFSearch } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'
---

<PageLayout meta={{ title: '搜索', description: '全文搜索本站文章' }}>
  <header class='page-intro'>
    <p class='eyebrow mono'><span>Search</span><span>Pagefind · 全文索引</span></p>
    <h1>Search <small>搜索</small></h1>
    <p class='lede'>搜索全部文章的正文。只想按标题过滤，用 <a href='/blog'>文章</a> 页的过滤框更快。</p>
  </header>
  <div class='search-box'>
    {integ.pagefind ? <PFSearch /> : <p>搜索未启用。</p>}
  </div>
</PageLayout>

<style>
  .page-intro a {
    color: hsl(var(--primary));
  }
  .search-box {
    max-width: 46rem;
  }
</style>
