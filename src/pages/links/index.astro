---
import links from 'public/links.json'
import config from 'virtual:config'

import PageLayout from '@/layouts/BaseLayout.astro'
import FriendList from '@/components/links/FriendList.astro'

const { friends } = links
const linksConf = config.integ.links
const linkEditPage = 'https://github.com/jerry609/jerry609.github.io/blob/main/public/links.json'
---

<PageLayout meta={{ title: '友链', description: '朋友们的站点' }}>
  <header class='page-intro'>
    <p class='eyebrow mono'><span>Links</span><span>{friends[0].link_list.length} friends</span></p>
    <h1>Links <small>友链</small></h1>
    <p class='lede'>朋友们的站点，顺序随机。</p>
  </header>

  <FriendList list={friends[0]} />

  <section class='apply'>
    <div class='sec-head'><h2 class='sec-title'>Apply<span class='zh'>交换友链</span></h2></div>
    <p class='muted'>本站信息（点击复制）：</p>
    <dl class='site-info'>
      {
        linksConf.applyTip.map(({ name, val }) => (
          <div>
            <dt class='mono'>{name}</dt>
            <dd>
              <button class='copy mono' type='button' data-val={val}>
                {val}
              </button>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class='muted'>
      在 <a href={linkEditPage} target='_blank' rel='noopener'>public/links.json</a>
      提交 PR 即可。请先在你的站点加上本站，并确保站点可以正常访问。
    </p>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.site-info .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const val = btn.dataset.val || ''
      try {
        await navigator.clipboard.writeText(val)
        document.dispatchEvent(new CustomEvent('toast', { detail: { message: `已复制 ${val}` } }))
      } catch {
        const range = document.createRange()
        range.selectNodeContents(btn)
        const sel = window.getSelection()
        sel?.removeAllRanges()
        sel?.addRange(range)
      }
    })
  })
</script>

<style>
  .apply {
    margin-top: 3.5rem;
    max-width: 46rem;
  }
  .muted {
    color: hsl(var(--muted-foreground));
  }
  .muted a {
    color: hsl(var(--primary));
  }
  .site-info {
    margin: 0.75rem 0 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  .site-info div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .site-info dt {
    color: hsl(var(--faint));
  }
  .site-info dd {
    margin: 0;
    min-width: 0;
  }
  .copy {
    font-size: 0.85rem;
    background: none;
    border: 0;
    padding: 0;
    color: hsl(var(--foreground));
    cursor: pointer;
    text-align: left;
    word-break: break-all;
  }
  .copy:hover {
    color: hsl(var(--primary));
  }
</style>
