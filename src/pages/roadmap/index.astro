---
import PageLayout from '@/layouts/BaseLayout.astro'
import {
  bins,
  EDGES,
  flatten,
  levels,
  MAIN_LINE,
  median,
  meta,
  rating,
  topicHref,
  TOPICS,
  uniqueProblems
} from '@/data/algorithms'

const depth = levels()
const maxLevel = Math.max(...Object.values(depth))
const ids = Object.keys(TOPICS)
const flat = Object.fromEntries(ids.map((id) => [id, flatten(TOPICS[id])]))
const ready = ids.filter((id) => flat[id].length > 0)
const all = uniqueProblems()
const rated = all.filter((p) => rating(p) !== undefined)
const premium = all.filter((p) => p.vip || meta(p.id)?.paid).length
const unrated = all.filter((p) => rating(p) === undefined)
const official = { easy: 0, medium: 0, hard: 0 }
for (const p of unrated) {
  const d = meta(p.id)?.difficulty
  if (d) official[d]++
}
const fmt = (n: number) => n.toLocaleString('en-US')

// ---- Fig. 1: topic graph (main line runs straight through the middle row) ----
const W = 1060
const NW = 132
const NH = 64
const ROW = 92
const byLevel: Record<number, string[]> = {}
for (const id of ids) (byLevel[depth[id]] ??= []).push(id)
const offsets = [1, -1, 2, -2]
const rowsUsed: number[] = []
const pos: Record<string, { x: number; row: number }> = {}
for (const [lv, list] of Object.entries(byLevel)) {
  const main = list.find((id) => MAIN_LINE.includes(id))
  const rest = list.filter((id) => id !== main).sort((a, b) => flat[b].length - flat[a].length)
  const x = 14 + (Number(lv) * (W - 28 - NW)) / maxLevel
  if (main) pos[main] = { x, row: 0 }
  rest.forEach((id, i) => {
    pos[id] = { x, row: main ? (offsets[i] ?? i + 1) : i }
  })
  for (const id of list) rowsUsed.push(pos[id].row)
}
const minRow = Math.min(...rowsUsed)
const maxRow = Math.max(...rowsUsed)
const H = (maxRow - minRow) * ROW + NH + 28
const yOf = (row: number) => 14 + (row - minRow) * ROW
const mainEdges = new Set(MAIN_LINE.slice(1).map((b, i) => `${MAIN_LINE[i]}>${b}`))
const edgePaths = EDGES.map(([a, b]) => {
  const x1 = pos[a].x + NW
  const y1 = yOf(pos[a].row) + NH / 2
  const x2 = pos[b].x
  const y2 = yOf(pos[b].row) + NH / 2
  const mx = Math.round((x1 + x2) / 2)
  return { d: `M${x1} ${y1} H${mx} V${y2} H${x2}`, main: mainEdges.has(`${a}>${b}`) }
})

// ---- Fig. 2: difficulty histogram ----
const allBins = bins(all)
const binKeys = Object.keys(allBins)
  .map(Number)
  .sort((a, b) => a - b)
const binMax = Math.max(...Object.values(allBins))
const HW = 1060
const HH = 170
const bw = (HW - 60) / binKeys.length
const med = median(all)

// ---- Fig. 3: topics table ----
const rows = [...ids].sort((a, b) => depth[a] - depth[b] || flat[b].length - flat[a].length)
const sparkKeys = Array.from({ length: 11 }, (_, i) => 1000 + i * 200)
const pad = (n: number) => String(n).padStart(2, '0')
---

<PageLayout meta={{ title: '算法训练', description: '灵茶山艾府题单的结构化索引：专题依赖图、难度分布和题目直链' }}>
  <header class='page-intro'>
    <p class='eyebrow mono'>
      <span>Algorithms</span><span>{ids.length} topics</span><span>{fmt(all.length)} problems</span>
    </p>
    <h1>Algorithms <small>算法训练</small></h1>
    <p class='lede'>
      <a href='https://leetcode.cn/discuss/post/RvFUtj/' target='_blank' rel='noopener'>灵茶山艾府题单</a
      >的结构化索引。专题之间是一张依赖图，橙色是推荐的主线；每道题标了竞赛难度分（没有的标官方难度），直接链到力扣。
    </p>
  </header>

  <div class='readouts'>
    <div><span class='k'>Problems</span><b class='readout'>{fmt(all.length)}</b><span class='s'>去重后的题目</span></div>
    <div><span class='k'>Rated</span><b class='readout'>{fmt(rated.length)}</b><span class='s'>有竞赛难度分</span></div>
    <div>
      <span class='k'>Topics</span><b class='readout'>{ready.length}/{ids.length}</b><span class='s'
        >已整理题单的专题</span
      >
    </div>
    <div><span class='k'>Premium</span><b class='readout'>{premium}</b><span class='s'>会员题</span></div>
  </div>

  <figure class='fig'>
    <div class='fig-head'><span class='fig-title'>Topic graph</span></div>
    <div class='fig-panel scroll'>
      <svg viewBox={`0 0 ${W} ${H}`} class='dag' role='img' aria-label='专题依赖图'>
        {edgePaths.map((e) => <path class:list={['e', e.main && 'main']} d={e.d} />)}
        {
          ids.map((id) => {
            const t = TOPICS[id]
            const n = flat[id].length
            const p = pos[id]
            const m = median(flat[id])
            const inner = (
              <>
                <rect width={NW} height={NH} rx='2' />
                <text x='10' y='24' class='nt'>
                  {t.title.length > 9 ? `${t.title.slice(0, 8)}…` : t.title}
                </text>
                <text x='10' y='44' class='nm'>
                  {n ? `${n} 题${m ? ` · 中位 ${m}` : ''}` : 'TODO · 整理中'}
                </text>
              </>
            )
            const cls = ['node', MAIN_LINE.includes(id) && 'main', !n && 'empty'].filter(Boolean).join(' ')
            return n ? (
              <a href={topicHref(id)} class={cls}>
                <title>{t.title}</title>
                <g transform={`translate(${p.x},${yOf(p.row)})`}>{inner}</g>
              </a>
            ) : (
              <g class={cls} transform={`translate(${p.x},${yOf(p.row)})`}>
                {inner}
              </g>
            )
          })
        }
      </svg>
    </div>
    <p class='fig-cap'>
      每个方框是一个专题，箭头是前置关系，从左到右是推荐的学习顺序。橙色主线：{
        MAIN_LINE.map((id) => TOPICS[id].title).join(' → ')
      }。虚线框的专题还没有整理题单。
    </p>
  </figure>

  <figure class='fig'>
    <div class='fig-head'><span class='fig-title'>Difficulty distribution</span></div>
    <div class='fig-panel'>
      <svg viewBox={`0 -18 ${HW} ${HH + 52}`} class='hist' role='img' aria-label='难度分布'>
        {
          binKeys.map((k, i) => {
            const v = allBins[k]
            const bh = (v / binMax) * HH
            const x = 40 + i * bw
            const isMed = med !== undefined && med >= k && k + 200 > med
            const bandFill = k < 1600 ? '#00CD6E' : k < 2000 ? '#2B5CFF' : k < 2400 ? '#FA6D01' : '#DE99FE'
            return (
              <g>
                <rect
                  class:list={['bar', isMed && 'med']}
                  style={`fill:${bandFill}`}
                  x={x + 3}
                  y={HH - bh + 6}
                  width={bw - 6}
                  height={bh}
                />
                <text class='bv' x={x + bw / 2} y={HH - bh} text-anchor='middle'>
                  {v}
                </text>
                <text class='bx' x={x + bw / 2} y={HH + 24} text-anchor='middle'>
                  {k}
                </text>
              </g>
            )
          })
        }
        <line class='base' x1='40' x2={HW - 20} y1={HH + 6} y2={HH + 6} />
      </svg>
    </div>
    <p class='fig-cap'>
      {fmt(rated.length)} 道有竞赛难度分的题，按 200 分一档统计，中位数 {med}（橙色那一档）。其余 {
        fmt(unrated.length)
      } 道没有竞赛分，按力扣官方难度：简单 {official.easy}、中等 {official.medium}、困难 {official.hard}。
    </p>
  </figure>

  <figure class='fig'>
    <div class='fig-head'><span class='fig-title'>Topics</span></div>
    <div class='fig-panel tight'>
      <table class='topics'>
        <thead>
          <tr>
            <th>Lv</th><th>专题</th><th class='r'>题数</th><th>难度分布 1000 → 3000</th><th class='r'
              >中位分</th
            ><th class='r'>会员题</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((id) => {
              const ps = flat[id]
              const b = bins(ps)
              const bm = Math.max(1, ...Object.values(b))
              const m = median(ps)
              const vip = ps.filter((p) => p.vip).length
              return (
                <tr class:list={[!ps.length && 'empty']}>
                  <td class='mono lv'>{pad(depth[id] + 1)}</td>
                  <td class='tt'>
                    {ps.length ? <a href={topicHref(id)}>{TOPICS[id].title}</a> : TOPICS[id].title}
                    {MAIN_LINE.includes(id) && <span class='tag'>main line</span>}
                  </td>
                  <td class='mono r'>{ps.length || '—'}</td>
                  <td>
                    {ps.length ? (
                      <span class='spark' aria-label={`中位 ${m ?? '—'}`}>
                        {sparkKeys.map((k) => (
                          <i style={`height:${Math.max(1, ((b[k] ?? 0) / bm) * 18).toFixed(1)}px`} />
                        ))}
                      </span>
                    ) : (
                      <span class='mono todo'>TODO</span>
                    )}
                  </td>
                  <td class='mono r'>{m ?? '—'}</td>
                  <td class='mono r'>{ps.length ? vip : '—'}</td>
                </tr>
              )
            })
          }
        </tbody>
      </table>
    </div>
  </figure>
</PageLayout>

<style>
  .page-intro a {
    color: hsl(var(--primary));
  }
  .page-intro {
    margin-bottom: 1.75rem;
  }
  .readouts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1.5px solid var(--ink-hard, #171716);
    border-radius: 2px;
    background: hsl(var(--card));
    margin-bottom: 2.5rem;
  }
  .readouts > div {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    border-left: 1px solid hsl(var(--border));
  }
  .readouts > div:first-child {
    border-left: 0;
  }
  .readouts .k {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .readouts b {
    font-size: 1.95rem;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: hsl(var(--foreground));
  }
  .readouts .s {
    font-size: 0.78rem;
    color: hsl(var(--muted-foreground));
  }
  .fig {
    counter-increment: fig;
    margin: 0 0 2.75rem;
  }
  :global(.site-main) {
    counter-reset: fig;
  }
  /* Matte Obsidian Dark Telemetry Panels for DAG & Rating Histogram */
  .fig .fig-panel:not(.tight) {
    background: #1d1d1d;
    border: 1.5px solid #020100;
    border-radius: 2px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .scroll {
    overflow-x: auto;
  }
  .dag {
    display: block;
    width: 100%;
    min-width: 860px;
  }
  .dag .e {
    fill: none;
    stroke: #4c4c48;
    stroke-width: 1.3;
  }
  .dag .e.main {
    stroke: #fa6d01;
    stroke-width: 2;
  }
  .dag .node rect {
    fill: #242422;
    stroke: #00cd6e;
    stroke-width: 1.3;
    transition: fill 0.15s ease;
  }
  .dag .node.main rect {
    fill: #232321;
    stroke: #fa6d01;
    stroke-width: 1.75;
  }
  .dag .node.empty rect {
    fill: #171716;
    stroke: #4e4e4a;
    stroke-dasharray: 4 3;
  }
  .dag a.node:hover rect,
  .dag a.node:focus-visible rect {
    fill: #32251c;
  }
  .dag .nt {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    fill: #f0f0ef;
  }
  .dag .empty .nt {
    fill: #7c7c78;
  }
  .dag .nm {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: #9a9a97;
  }
  .hist {
    display: block;
    width: 100%;
  }
  .hist .bar {
    fill: #2b5cff;
  }
  .hist .bar.med {
    stroke: #f8e600;
    stroke-width: 1.5;
  }
  .hist .bv,
  .hist .bx {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: #9a9a97;
  }
  .hist .base {
    stroke: #383836;
  }
  .tight {
    padding: 0.5rem 1rem;
    overflow-x: auto;
    border: 1.5px solid var(--ink-hard, #171716);
    border-radius: 2px;
  }
  .topics {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .topics th {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--faint));
    text-align: left;
    padding: 0.55rem 0.5rem;
    border-bottom: var(--hair) solid hsl(var(--border));
  }
  .topics td {
    padding: 0.6rem 0.5rem;
    border-bottom: var(--hair) solid hsl(var(--border));
    vertical-align: middle;
  }
  .topics tr:last-child td {
    border-bottom: 0;
  }
  .topics .r {
    text-align: right;
  }
  .topics .lv {
    color: hsl(var(--faint));
    font-size: 0.75rem;
  }
  .topics .tt a {
    font-weight: 500;
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .topics .tt a:hover {
    color: hsl(var(--primary));
  }
  .topics tr.empty td {
    color: hsl(var(--faint));
  }
  .tag {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: hsl(var(--primary));
    border: var(--hair) solid hsl(var(--scarf));
    border-radius: var(--radius);
    padding: 0 0.3rem;
  }
  .spark {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 18px;
  }
  .spark i {
    display: block;
    width: 6px;
    background: hsl(var(--foreground));
  }
  .todo {
    font-size: 0.7rem;
  }
  @media (max-width: 720px) {
    .readouts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .readouts > div:nth-child(3) {
      border-left: 0;
    }
    .readouts > div:nth-child(n + 3) {
      border-top: var(--hair) solid hsl(var(--border));
    }
  }
</style>
