---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection } from 'astro-pure/server'
import avatar from '@/assets/jerry.jpg'
import PageLayout from '@/layouts/BaseLayout.astro'
import { LAYERS, layerLabel, PROJECTS, SERIES } from '@/data/stack'

const posts = ((await getBlogCollection('blog')) as CollectionEntry<'blog'>[]).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const bySlug = Object.fromEntries(posts.map((p) => [p.id, p]))

const interests = [
  {
    layer: 'agent',
    text: 'Coding agent 的 harness：上下文怎么组织，工具调用怎么分发和归一化，长时运行的 loop 怎么收敛。',
    reads: ['agent-system-design-llm-limitations', 'claude-code-cccontext-deep-dive', 'tool-call-dispatch-normalize-design']
  },
  {
    layer: 'runtime',
    text: 'Agent 的执行环境：从 chroot 到 microVM 的沙箱、工具网关，以及并发下的正确性。',
    reads: ['sandbox-tech-1', 'e2b-source-analysis-1', 'debug-retrospective-lightweight-sandbox-race-condition']
  },
  {
    layer: 'model',
    text: 'Transformer 的机制：Attention、位置编码、KV Cache 的压缩与检索，以及用 SAE 做机制诊断。',
    reads: ['attention-series-outline', 'kv-cache-prefill-decode-eviction', 'sparse-autoencoder-deep-dive']
  },
  {
    layer: 'training',
    text: '后训练：从策略梯度到 PPO、GRPO，再用 KL 投影把 SFT 和 RL 放到同一个框架里。',
    reads: ['reinforce-to-ppo-policy-gradient', 'sft-forward-kl-formal-modeling', 'rl-reward-tilting-kl-regularized-projection']
  },
  {
    layer: 'systems',
    text: '底层系统：FUSE 虚拟文件系统、Monorepo 与 Buck2 构建、Go 与 Rust 的性能剖析。',
    reads: ['scorpio-fuse-explained', 'fuse-development-pitfalls-async-optimization', 'go-trace-pprof-performance-analysis']
  }
].map((i) => ({ ...i, reads: i.reads.map((s) => bySlug[s]).filter(Boolean) }))

const habits = [
  {
    title: '从源码出发',
    text: '读 Claude Code、Claude Agent SDK、E2B、ast-grep、oh-my-codex 的实现，搞清楚一个设计在代码里到底长什么样。',
    href: '/blog?layer=agent'
  },
  {
    title: '从故障出发',
    text: '把排查过的问题完整写下来：FUSE 上的阻塞、测试超时、OverlayFS copy-up、ESTALE、沙箱里的竞态。',
    href: '/blog/buck2-fuse-build-debugging'
  },
  {
    title: '从公式出发',
    text: '把 RL、Attention、正则化的推导从头走一遍，写成讲义和 PDF，能复用的结论单独拎出来。',
    href: '/math-notes'
  }
]

const history = [
  { date: '2025-03', text: '建立这个仓库，站点最初由 Hexo 生成。' },
  { date: '2025-11', text: '用 Astro 重建，开始系统地写源码分析和故障复盘。' },
  { date: '2026-03', text: '开始写 Harness Engineering 和「Attention 机制完全指南」两个系列。' },
  { date: '2026-11', text: '改版：文章按 Agent × Infra 的六层栈重新组织，首页加入写作轨迹图。' }
]

const facts = [
  { k: '学校', v: '中国科学院信息工程研究所' },
  { k: '身份', v: '硕士研究生' },
  { k: '城市', v: '北京 / 福建' },
  { k: '方向', v: 'Agent × Infra' },
  { k: '文章', v: `${posts.length} 篇 · ${SERIES.length} 个连载` },
  { k: '起始', v: posts[posts.length - 1]?.data.publishDate.toISOString().slice(0, 7) ?? '' }
]
---

<PageLayout meta={{ title: '关于', description: 'Jerry Zhang：Agent × Infra 全栈研究' }}>
  <header class='page-intro about-intro'>
    <Image src={avatar} alt='Jerry Zhang 的头像' width={192} height={192} class='avatar' />
    <div>
      <p class='eyebrow mono'><span>About</span><span>Jerry Zhang</span><span>张瑞杰</span></p>
      <h1>About <small>关于</small></h1>
      <p class='lede'>
        我是张瑞杰，中国科学院信息工程研究所的硕士研究生。研究兴趣是 Agent，以及让 Agent
        真正跑起来的那一整条基础设施。
      </p>
    </div>
  </header>

  <div class='about-grid'>
    <div class='about-main'>
      <section>
        <h2 class='h'>Research interests<span class='zh'>研究兴趣</span></h2>
        <ul class='interests'>
          {
            interests.map((i) => (
              <li>
                <a class='mono code' href={`/blog?layer=${i.layer}`}>
                  {layerLabel(i.layer)}
                </a>
                <div>
                  <p>{i.text}</p>
                  <p class='reads'>
                    {i.reads.map((p) => (
                      <a href={`/blog/${p.id}`}>{p.data.title}</a>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class='h'>How I work<span class='zh'>我怎么理解一个系统</span></h2>
        <div class='habits'>
          {
            habits.map((h) => (
              <a class='habit' href={h.href}>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class='h'>Projects<span class='zh'>项目</span></h2>
        <ul class='plain'>
          {
            PROJECTS.map((p) => (
              <li>
                <a
                  href={p.href}
                  {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {p.name}
                </a>
                <span>{p.summary}</span>
              </li>
            ))
          }
        </ul>
        <a class='mono more' href='/projects'>全部项目 →</a>
      </section>

      <section>
        <h2 class='h'>This site<span class='zh'>关于本站</span></h2>
        <ul class='history'>
          {
            history.map((h) => (
              <li>
                <span class='mono'>{h.date}</span>
                <span>{h.text}</span>
              </li>
            ))
          }
        </ul>
        <p class='colophon'>
          用 <a href='https://astro.build/' target='_blank' rel='noopener'>Astro</a> 构建，部署在 GitHub
          Pages。全文搜索用 Pagefind，公式用 KaTeX 渲染，字体是 Source Serif 4、Geist 和 Geist
          Mono，全部自托管。站点源码在
          <a href='https://github.com/jerry609/jerry609.github.io' target='_blank' rel='noopener'
            >jerry609/jerry609.github.io</a
          >。
        </p>
      </section>

      <blockquote class='pg'>
        <p>所以，你要做的，就是增加自己被运气青睐的概率。而增加的方式，正是保持好奇心。尝试更多事、见更多人、读更多书、问更多问题。</p>
        <p>终极大奖就是寻找到缝隙中那根有可能生长出来的枝杈。你发现了知识表层的裂缝，将它破开，而后洞见了一个崭新的世界。</p>
        <footer class='mono'>Paul Graham</footer>
      </blockquote>
    </div>

    <aside class='about-side'>
      <dl class='facts'>
        {
          facts.map((f) => (
            <div>
              <dt class='mono'>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class='contact'>
        <p class='mono label'>联系</p>
        <a href='https://github.com/jerry609' target='_blank' rel='noopener'>github.com/jerry609 ↗</a>
        <a href='/rss.xml'>RSS 订阅</a>
      </div>
      <div class='contact'>
        <p class='mono label'>栈层</p>
        {
          LAYERS.map((l) => (
            <a href={`/blog?layer=${l.id}`}>
              <span class='mono'>{l.code}</span> {l.name}
            </a>
          ))
        }
      </div>
    </aside>
  </div>
</PageLayout>

<style>
  .about-intro {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 2.25rem;
    align-items: start;
  }
  .avatar {
    width: 8.5rem;
    height: 8.5rem;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid hsl(var(--border));
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 4rem;
    align-items: start;
  }
  .about-main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    min-width: 0;
  }
  .h {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
  }
  .h .zh {
    font-family: var(--font-body);
    font-size: 0.55em;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    margin-left: 0.5rem;
  }
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--border));
  }
  .interests li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .interests .code {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    padding-top: 0.15rem;
  }
  .interests .code:hover {
    color: hsl(var(--primary));
  }
  .interests p {
    margin: 0;
    line-height: 1.75;
  }
  .reads {
    margin-top: 0.375rem !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.85rem;
  }
  .reads a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--border));
  }
  .reads a:hover {
    color: hsl(var(--primary));
    border-bottom-color: hsl(var(--primary));
  }
  .habits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .habit {
    border-top: 2px solid hsl(var(--foreground));
    padding-top: 0.875rem;
    text-decoration: none;
    color: inherit;
  }
  .habit h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.375rem;
  }
  .habit:hover h3 {
    color: hsl(var(--primary));
  }
  .habit p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--border));
  }
  .plain li {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .plain a {
    font-weight: 600;
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .plain a:hover {
    color: hsl(var(--primary));
  }
  .plain span {
    color: hsl(var(--muted-foreground));
  }
  .more {
    display: inline-block;
    margin-top: 0.75rem;
    color: hsl(var(--primary));
    text-decoration: none;
  }
  .history {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid hsl(var(--border));
  }
  .history li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.4rem 0 0.4rem 1rem;
    position: relative;
    font-size: 0.94rem;
  }
  .history li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.95rem;
    width: 7px;
    height: 7px;
    border-radius: 1px;
    background: hsl(var(--foreground));
  }
  .history .mono {
    color: hsl(var(--faint));
    padding-top: 0.1rem;
  }
  .colophon {
    margin: 1.25rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .colophon a {
    color: hsl(var(--primary));
  }
  .pg {
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.85;
  }
  .pg p {
    margin: 0 0 0.75rem;
  }
  .pg footer {
    color: hsl(var(--faint));
  }
  .about-side {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .facts {
    margin: 0;
    border-top: 2px solid hsl(var(--foreground));
  }
  .facts div {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 0.875rem;
  }
  .facts dt {
    color: hsl(var(--faint));
  }
  .facts dd {
    margin: 0;
  }
  .contact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.875rem;
  }
  .contact .label {
    margin: 0 0 0.25rem;
    color: hsl(var(--faint));
  }
  .contact a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .contact a:hover {
    color: hsl(var(--primary));
  }
  .contact a .mono {
    color: hsl(var(--faint));
    margin-right: 0.25rem;
  }
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .about-side {
      position: static;
    }
    .habits {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .avatar {
      width: 5rem;
      height: 5rem;
    }
    .interests li,
    .plain li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
