---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTags } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { layerLabel } from '@/data/stack'
import config from '@/site-config'
import { sortBlogPosts } from '@/utils/blog'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = (await getBlogCollection('blog')) as CollectionEntry<'blog'>[]
  const allPostsByDate = sortBlogPosts(allPosts)
  const uniqueTags = getUniqueTags(allPostsByDate)

  return uniqueTags.flatMap((tag) => {
    const filterPosts = allPostsByDate.filter((post) => 'tags' in post.data && post.data.tags.includes(tag))
    return paginate(filterPosts, {
      pageSize: config.content.blogPageSize,
      params: { tag }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props
const { tag } = Astro.params

const meta = {
  description: `标签 ${tag} 下的全部文章`,
  title: `标签：${tag}`
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← 上一页`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `下一页 →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <header class='page-intro'>
    <p class='eyebrow mono'><a href='/tags'>Tags</a><span>{page.total} posts</span></p>
    <h1>#{tag}</h1>
  </header>
  <ul class='rows'>
    {
      page.data.map((p) => (
        <li>
          <a class='row' href={`/blog/${p.id}`}>
            <span class='row-d mono'>{p.data.publishDate.toISOString().slice(0, 10)}</span>
            <span>
              <span class='row-t'>{p.data.title}</span>
              <span class='row-x'>{p.data.description}</span>
            </span>
            <span class='row-l mono'>{layerLabel(p.data.layer)}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <Paginator {...paginationProps} />
</PageLayout>

<style>
  .eyebrow a {
    color: hsl(var(--primary));
    text-decoration: none;
  }
</style>
