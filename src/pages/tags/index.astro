---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'

const allPosts = await getBlogCollection()
const allTags = getUniqueTagsWithCount(allPosts)
---

<PageLayout meta={{ title: '标签', description: '全部文章标签' }}>
  <header class='page-intro'>
    <p class='eyebrow mono'><span>Tags</span><span>{allTags.length} tags</span></p>
    <h1>Tags <small>标签</small></h1>
    <p class='lede'>按出现次数排列。更粗的分类见 <a href='/blog'>文章</a> 页的栈层筛选。</p>
  </header>

  {
    allTags.length > 0 ? (
      <ul class='tags'>
        {allTags.map(([tag, val]) => (
          <li>
            <a href={`/tags/${tag}`} class={val > 4 ? 'big' : val > 1 ? 'mid' : ''}>
              {tag}
              <span class='mono'>{val}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>还没有标签。</p>
    )
  }
</PageLayout>

<style>
  .page-intro a {
    color: hsl(var(--primary));
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.2rem 0.65rem;
    border: var(--hair) solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card));
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    font-size: 0.82rem;
  }
  .tags a.mid {
    font-size: 0.92rem;
    color: hsl(var(--foreground));
  }
  .tags a.big {
    font-size: 1.05rem;
    color: hsl(var(--foreground));
    border-color: hsl(var(--faint));
  }
  .tags a:hover {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.5);
  }
  .tags .mono {
    font-size: 0.7rem;
    color: hsl(var(--faint));
  }
</style>
