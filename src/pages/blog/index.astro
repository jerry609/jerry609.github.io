---
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostCover from '@/components/blog/PostCover.astro'
import WritingIndex from '@/components/home/WritingIndex.astro'
import { ALL_LAYERS } from '@/data/stack'
import { buildCovers } from '@/utils/cover'

export const prerender = true

const posts = ((await getBlogCollection('blog')) as CollectionEntry<'blog'>[]).sort(
  (a, b) =>
    b.data.pinned - a.data.pinned || b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const byDate = [...posts].sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
const covers = buildCovers(posts)
const [featured, ...rest] = posts
const cards = rest.slice(0, 6)

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC']
const stamp = (d: Date) =>
  `${String(d.getUTCDate()).padStart(2, '0')} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`
const layerName = (l: string) => {
  const L = ALL_LAYERS.find((x) => x.id === l)
  return L && L.code ? `${L.code} ${L.name}` : 'Notes'
}
---

<PageLayout meta={{ title: '文章', description: '按 Agent × Infra 栈分层的全部文章' }}>
  <h1 class='sr-only'>文章</h1>
  <div class='bar mono'>
    <span>Writing</span>
    <span>{posts.length} posts</span>
    <a href='/rss.xml'>RSS</a>
    <a href='/archives'>Archive</a>
  </div>

  <section class='grid' aria-label='最新文章'>
    <article class='feat'>
      <a href={`/blog/${featured.id}`} class='card-link'>
        <PostCover post={featured} cover={covers.get(featured.id)!} size='lg' eager />
        <h2 class='feat-t'>{featured.data.title}</h2>
        <p class='meta mono'>
          {stamp(featured.data.publishDate)} · {layerName(featured.data.layer)}
        </p>
        <p class='ex mono'>{featured.data.description}</p>
        <span class='go mono'>Read →</span>
      </a>
    </article>
    <div class='cards'>
      {
        cards.map((p) => (
          <article class='card'>
            <a href={`/blog/${p.id}`} class='card-link'>
              <PostCover post={p} cover={covers.get(p.id)!} />
              <h3 class='card-t'>{p.data.title}</h3>
              <p class='meta mono'>
                {stamp(p.data.publishDate)} · {layerName(p.data.layer)}
              </p>
              <p class='ex mono'>{p.data.description}</p>
              <span class='go mono'>Read →</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class='all' aria-label='全部文章'>
    <WritingIndex posts={byDate} limit={15} id='blog-writing' />
  </section>
</PageLayout>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0.5rem 0 0.9rem;
    margin-bottom: 1.75rem;
    border-bottom: var(--hair) solid hsl(var(--border));
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .bar span:first-child {
    color: hsl(var(--foreground));
  }
  .bar a {
    color: hsl(var(--faint));
    text-decoration: none;
  }
  .bar a:hover {
    color: hsl(var(--primary));
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 3fr);
    gap: 2.5rem;
    margin-bottom: 4rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.75rem 1.75rem;
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .card-link:hover {
    color: inherit;
  }
  .card-link:hover .feat-t,
  .card-link:hover .card-t {
    color: hsl(var(--primary));
  }
  .card-link:hover .go {
    color: hsl(var(--primary));
  }
  .feat-t {
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0.75rem 0 0;
    text-wrap: pretty;
    transition: color 0.15s ease;
  }
  .card-t {
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0.6rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }
  .meta {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .ex {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .go {
    margin-top: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--foreground));
    transition: color 0.15s ease;
  }
  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }
  }
  @media (max-width: 480px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
