---
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PixelMouse from '@/components/brand/PixelMouse.astro'
import Deadlines from '@/components/home/Deadlines.astro'
import HeroFabric from '@/components/home/HeroFabric.astro'
import NowPlaying from '@/components/home/NowPlaying.astro'
import Publications from '@/components/home/Publications.astro'
import StackTrace from '@/components/home/StackTrace.astro'
import TeardownBench from '@/components/home/TeardownBench.astro'
import WritingIndex from '@/components/home/WritingIndex.astro'
import { layerColor, layerLabel, SERIES } from '@/data/stack'

const allPosts = (await getBlogCollection('blog')) as CollectionEntry<'blog'>[]
const byDate = [...allPosts].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const bySlug = Object.fromEntries(allPosts.map((p) => [p.id, p]))

const research = [
  { layer: 'agent', text: 'Agent harness：上下文管理、工具调用的分发与归一化、长时运行的 agent loop。' },
  { layer: 'runtime', text: '运行时：沙箱隔离（容器、microVM）、工具网关，以及并发下的正确性。' },
  { layer: 'model', text: '模型机制：Attention、KV Cache 的压缩与检索、稀疏自编码器与可解释性。' },
  { layer: 'training', text: '后训练：策略梯度、PPO 与 GRPO，用 KL 投影统一看 SFT 和 RL。' },
  { layer: 'systems', text: '系统与加速：GPU/NPU 算子优化、FUSE 虚拟文件系统、Monorepo 与 Buck2 构建、性能剖析。' }
]

const news = [
  { date: '2026-11', text: '网站升级：引入 3D AI 加速器 Teardown 机台与瑞士专色六层栈设计体系。' },
  {
    date: '2026-06',
    text: '「形式化建模」两篇：SFT 是前向 KL 投影，RL 是 reward-tilting 与 KL 正则投影。',
    href: '/blog/sft-forward-kl-formal-modeling'
  },
  {
    date: '2026-05',
    text: '写完从 REINFORCE、PPO 到 GRPO 的策略梯度系列。',
    href: '/blog/reinforce-to-ppo-policy-gradient'
  },
  {
    date: '2026-04',
    text: 'RoPE 讲义上线，41 页，附 PDF。',
    href: '/blog/rope-lecture'
  },
  {
    date: '2026-03',
    text: '开始连载「Attention 机制完全指南」，计划 16 讲。',
    href: '/blog/attention-series-outline'
  },
  {
    date: '2026-03',
    text: 'Harness Engineering 系列：Agent 系统设计、CCContext、Tool Gateway。',
    href: '/blog/agent-system-design-llm-limitations'
  },
  {
    date: '2025-12',
    text: 'Claude Agent SDK 源码系列，以及 Dicfuse / Buck2 的五篇深度复盘。',
    href: '/blog/claude-agent-sdk-1'
  },
  { date: '2025-11', text: '博客从 Hexo 迁移到 Astro。' }
]

const seriesMeta: Record<string, { mat: string; dark: boolean; captionA: string; captionB: string }> = {
  attention: { mat: '#DE99FE', dark: false, captionA: 'CAUSAL MASK', captionB: 'SOFTMAX SIMPLEX' },
  rl: { mat: '#FA6D01', dark: true, captionA: 'REWARD-TILTED', captionB: 'KL PROJECTION' },
  'coding-agent': { mat: '#2B5CFF', dark: false, captionA: 'HARNESS LOOP', captionB: 'TOOL GATEWAY' },
  fuse: { mat: '#00CD6E', dark: true, captionA: 'KERNEL / USER', captionB: 'ASYNC IO TRACE' }
}

const series = SERIES.map((s) => {
  const posts = s.slugs.map((x) => bySlug[x]).filter(Boolean)
  const dates = posts.map((p) => p.data.publishDate.toISOString().slice(0, 7)).sort()
  const span = dates[0] === dates[dates.length - 1] ? dates[0] : `${dates[0]} → ${dates[dates.length - 1]}`
  const style = seriesMeta[s.id] ?? { mat: layerColor(s.layer), dark: false, captionA: 'SERIES', captionB: 'TRACK' }
  return { ...s, posts, span, ...style }
})
---

<PageLayout meta={{ title: '首页' }}>
  <!-- Hidden SVG Filter: 10fps Stepped Risograph Boil (0.mp4 DESSN craft) -->
  <svg width='0' height='0' style='position:absolute' aria-hidden='true'>
    <defs>
      <filter id='riso-boil' x='-8%' y='-8%' width='116%' height='116%'>
        <feTurbulence id='riso-turb' type='fractalNoise' baseFrequency='0.022' numOctaves='2' seed='2' result='n' />
        <feDisplacementMap in='SourceGraphic' in2='n' scale='1.4' xChannelSelector='R' yChannelSelector='G' />
      </filter>
    </defs>
  </svg>

  <main class='home'>
    {/* Hero: Systolic Fabric Backdrop + Asymmetric Editorial + DESSN Mouse + NowPlaying Window */}
    <section class='hero'>
      <HeroFabric />

      <div class='hero-top'>
        <div class='hero-left'>
          <p class='mono who'>
            <span class='sq-dot' style='background:var(--c-l6)' aria-hidden='true' />
            <span>JERRY ZHANG</span><span>UCAS · IIE</span><span>BEIJING</span>
          </p>
          <h1>
            Agent × Infra<br />全栈研究笔记。
            <span class='sub-en'>AI Accelerators, LLM Training Infra, Sandbox Runtimes &amp; Agent Harness.</span>
          </h1>
          <div class='hw-tags'>
            <span class='hw-pill mono'><span class='sq-dot' style='background:var(--c-l6)' />GPU / NPU KERNELS</span>
            <span class='hw-pill mono'><span class='sq-dot' style='background:var(--c-l5)' />HPC &amp; DISTRIBUTED SYS</span>
            <span class='hw-pill mono'><span class='sq-dot' style='background:var(--c-l3)' />LLM POST-TRAINING</span>
            <span class='hw-pill mono'><span class='sq-dot' style='background:var(--c-l2)' />FUSE / RUNTIME</span>
          </div>
        </div>

        <div class='hero-right'>
          <p class='hero-lead'>
            按 <strong>L6 Agent → L1 Math</strong> 六层栈记录从 GPU/NPU 算子与分布式训练底座、FUSE 文件系统与沙箱运行时，到模型机制与 Agent Harness 的源码拆解与第一性原理推导。
          </p>
          <div class='cta-row'>
            <a class='cta cta-solid mono' href='#teardown-lab'>3D TEARDOWN &gt;</a>
            <a class='cta cta-ghost mono' href='https://github.com/jerry609' target='_blank' rel='noopener'>GITHUB ↗</a>
            <a class='cta cta-ghost mono' href='/blog'>WRITING</a>
            <a class='cta cta-ghost mono' href='/rss.xml'>RSS</a>
          </div>
          <blockquote class='pg'>
            <p>
              “所以，你要做的，就是增加自己被运气青睐的概率……终极大奖就是寻找到缝隙中那根有可能生长出来的枝杈。你发现了知识表层的裂缝，将它破开，而后洞见了一个崭新的世界。”
            </p>
            <footer class='mono'>— PAUL GRAHAM · 保罗·格雷厄姆</footer>
          </blockquote>
        </div>
      </div>

      <div class='hero-horizon'>
        {/* DESSN Botanical-Green Framed Pixel Mouse (uses Jerry's real PixelMouse sprite!) */}
        <figure class='dessn-mat' aria-label='头像：戴耳机听歌的小白鼠'>
          <div class='dessn-card'>
            <div class='dessn-bar mono'>
              <span>~/jerry609</span>
              <span class='dessn-live'>♪ PLAYING</span>
            </div>
            <div class='dessn-stage'>
              <svg class='dessn-stripes' viewBox='0 0 320 260' preserveAspectRatio='none' aria-hidden='true'>
                <g class='dessn-stripes-g boil-layer' fill='#E3E1D4'>
                  <path d='M10,0 Q26,65 8,130 T14,260 L44,260 Q60,195 42,130 T48,0 Z' />
                  <path d='M84,0 Q100,65 82,130 T88,260 L118,260 Q134,195 116,130 T122,0 Z' />
                  <path d='M158,0 Q174,65 156,130 T162,260 L192,260 Q208,195 190,130 T196,0 Z' />
                  <path d='M232,0 Q248,65 230,130 T236,260 L266,260 Q282,195 264,130 T270,0 Z' />
                </g>
              </svg>
              <div class='dessn-mouse-wrap boil-layer'>
                <PixelMouse animated px={8} class='mascot' />
              </div>
            </div>
            <div class='dessn-foot mono'>
              <span>RISOBOIL · 10FPS</span>
              <span>如其所是</span>
            </div>
          </div>
        </figure>

        {/* Crisp-Ink NowReading Window */}
        <NowPlaying posts={byDate.slice(0, 10)} />
      </div>
    </section>

    {/* 3D Interactive AI Accelerator × Six-Layer Teardown Lab */}
    <TeardownBench />

    {/* Conference Deadlines Telemetry */}
    <Deadlines />

    <Publications />

    {/* Dark Obsidian Stack Trace */}
    <section>
      <div class='sec-head'>
        <h2 class='sec-title'>The Stack<span class='zh'>写作轨迹</span></h2>
        <span class='sec-note mono'>L6 AGENT → L1 MATH · CLICK LAYER TO FILTER</span>
      </div>
      <StackTrace posts={allPosts} />
    </section>

    {/* Research + News */}
    <section class='two-col'>
      <div>
        <div class='sec-head'>
          <h2 class='sec-title'>Research<span class='zh'>研究方向</span></h2>
          <span class='sec-note mono'>L6 → L2</span>
        </div>
        <ul class='research'>
          {
            research.map((r) => (
              <li>
                <a class='mono code' href={`/blog?layer=${r.layer}`}>
                  <span class='sq-dot' style={`background:${layerColor(r.layer)}`} aria-hidden='true' />
                  {layerLabel(r.layer)}
                </a>
                <span>{r.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <div class='sec-head'>
          <h2 class='sec-title'>News<span class='zh'>近况</span></h2>
          <span class='sec-note mono'>2025.11 — 2026.11</span>
        </div>
        <ul class='news'>
          {
            news.map((n) => (
              <li>
                <span class='mono date'>{n.date}</span>
                {n.href ? <a href={n.href}>{n.text}</a> : <span>{n.text}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Series: 2×2 Framed Chromatic Poster Mats with Clean Vector Schematics */}
    <section>
      <div class='sec-head'>
        <h2 class='sec-title'>Series<span class='zh'>专题连载</span></h2>
        <span class='sec-note mono'>按顺序读的成组文章 · 4 SERIES</span>
      </div>
      <div class='series-grid'>
        {
          series.map((s) => (
            <article class='poster-mat' style={`--mat-c:${s.mat}`}>
              <div class:list={['poster-inner', s.dark && 'dark-card']}>
                <div>
                  <div class='poster-top mono'>
                    <span>■ {layerLabel(s.layer)}</span>
                    <span>
                      {'planned' in s && s.planned ? `${s.posts.length} / ${s.planned} ${s.unit}` : `${s.posts.length} 篇`} · {s.span}
                    </span>
                  </div>

                  {/* Clean Domain SVG Schematic (Zero garbled ASCII) */}
                  <div class='poster-diagram' aria-hidden='true'>
                    {s.id === 'attention' && (
                      <svg viewBox='0 0 180 48'>
                        <g stroke='#171716' stroke-width='0.6' stroke-opacity='0.22'>
                          <rect x='2' y='2' width='10' height='10' fill='#DE99FE' />
                          <rect x='2' y='13' width='10' height='10' fill='#DE99FE' fill-opacity='0.45' />
                          <rect x='13' y='13' width='10' height='10' fill='#DE99FE' />
                          <rect x='2' y='24' width='10' height='10' fill='#DE99FE' fill-opacity='0.25' />
                          <rect x='13' y='24' width='10' height='10' fill='#DE99FE' fill-opacity='0.65' />
                          <rect x='24' y='24' width='10' height='10' fill='#DE99FE' />
                          <rect x='2' y='35' width='10' height='10' fill='#DE99FE' fill-opacity='0.18' />
                          <rect x='13' y='35' width='10' height='10' fill='#DE99FE' fill-opacity='0.38' />
                          <rect x='24' y='35' width='10' height='10' fill='#DE99FE' fill-opacity='0.72' />
                          <rect x='35' y='35' width='10' height='10' fill='#FA6D01' />
                        </g>
                        <line x1='60' y1='24' x2='78' y2='24' stroke='currentColor' stroke-width='1.2' />
                        <polygon points='78,21 84,24 78,27' fill='currentColor' />
                        <rect x='94' y='28' width='14' height='16' fill='#DE99FE' stroke='currentColor' stroke-width='0.9' />
                        <rect x='114' y='8' width='14' height='36' fill='#FA6D01' stroke='currentColor' stroke-width='0.9' />
                        <rect x='134' y='20' width='14' height='24' fill='#DE99FE' fill-opacity='0.65' stroke='currentColor' stroke-width='0.9' />
                        <rect x='154' y='34' width='14' height='10' fill='#D1D1CF' stroke='currentColor' stroke-width='0.9' />
                      </svg>
                    )}
                    {s.id === 'rl' && (
                      <svg viewBox='0 0 180 48'>
                        <line x1='4' y1='42' x2='174' y2='42' stroke='#454542' stroke-width='1' />
                        <path d='M12,42 C32,42 42,10 62,10 C82,10 92,42 112,42' fill='none' stroke='#8C8C88' stroke-width='1.4' stroke-dasharray='3 2.5' />
                        <path d='M56,42 C78,42 94,6 116,6 C138,6 148,42 168,42' fill='#F8E600' fill-opacity='0.16' stroke='#F8E600' stroke-width='1.8' />
                        <line x1='66' y1='16' x2='106' y2='16' stroke='#FA6D01' stroke-width='1.3' />
                        <polygon points='106,13 112,16 106,19' fill='#FA6D01' />
                      </svg>
                    )}
                    {s.id === 'coding-agent' && (
                      <svg viewBox='0 0 190 48'>
                        <rect x='4' y='13' width='38' height='22' fill='hsl(var(--card))' stroke='currentColor' stroke-width='1.2' />
                        <text x='23' y='27' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='currentColor'>CTX</text>
                        <line x1='42' y1='24' x2='56' y2='24' stroke='#2B5CFF' stroke-width='1.4' />
                        <rect x='58' y='13' width='44' height='22' fill='#2B5CFF' stroke='currentColor' stroke-width='1.2' />
                        <text x='80' y='27' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='#FFFFFF'>LOOP</text>
                        <line x1='102' y1='24' x2='116' y2='24' stroke='#2B5CFF' stroke-width='1.4' />
                        <rect x='118' y='13' width='48' height='22' fill='hsl(var(--card))' stroke='currentColor' stroke-width='1.2' />
                        <text x='142' y='27' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='currentColor'>TOOLS</text>
                        <path d='M142,35 L142,43 L23,43 L23,37' fill='none' stroke='#FA6D01' stroke-width='1.2' />
                        <polygon points='20,38 23,33 26,38' fill='#FA6D01' />
                      </svg>
                    )}
                    {s.id === 'fuse' && (
                      <svg viewBox='0 0 190 48'>
                        <line x1='2' y1='24' x2='184' y2='24' stroke='#474744' stroke-width='1' stroke-dasharray='3 2' />
                        <rect x='6' y='4' width='46' height='16' fill='#232321' stroke='#00CD6E' stroke-width='1.2' />
                        <text x='29' y='15' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='#00CD6E'>VFS</text>
                        <rect x='64' y='4' width='54' height='16' fill='#232321' stroke='#00CD6E' stroke-width='1.2' />
                        <text x='91' y='15' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='#F0F0EF'>/dev/fuse</text>
                        <rect x='64' y='28' width='54' height='16' fill='#00CD6E' stroke='#00CD6E' stroke-width='1.2' />
                        <text x='91' y='39' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='#141413'>DICFUSE</text>
                        <rect x='130' y='28' width='50' height='16' fill='#232321' stroke='#FA6D01' stroke-width='1.2' />
                        <text x='155' y='39' text-anchor='middle' font-family='Geist Mono Variable, monospace' font-size='8' fill='#FA6D01'>BUCK2</text>
                        <line x1='52' y1='12' x2='64' y2='12' stroke='#00CD6E' stroke-width='1.2' />
                        <line x1='91' y1='20' x2='91' y2='28' stroke='#00CD6E' stroke-width='1.2' />
                        <line x1='118' y1='36' x2='130' y2='36' stroke='#FA6D01' stroke-width='1.2' />
                      </svg>
                    )}
                    <div class='diagram-meta mono'>
                      <div>{s.captionA}</div>
                      <div>{s.captionB}</div>
                    </div>
                  </div>

                  <h3 class='poster-title'>
                    <a href={`/blog/${s.posts[0]?.id ?? ''}`}>{s.title}</a>
                  </h3>
                  <p class='poster-desc'>{s.desc}</p>
                </div>

                <div>
                  <ol class='poster-chapters'>
                    {s.posts.slice(0, 3).map((p, idx) => (
                      <li>
                        <a href={`/blog/${p.id}`}>
                          <span class='chap-num mono'>{String(idx + 1).padStart(2, '0')}</span>
                          <span class='chap-name'>{p.data.title}</span>
                          <span class='chap-date mono'>{p.data.publishDate.toISOString().slice(5, 10)}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                  <div class='poster-foot mono'>
                    <span>
                      {'planned' in s && s.planned
                        ? `PROGRESS ${Math.round((s.posts.length / s.planned) * 100)}%`
                        : `${s.posts.length} POSTS`}
                    </span>
                    <a class='poster-btn' href={`/blog/${s.posts[0]?.id ?? ''}`}>START READING &gt;</a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {/* Writing */}
    <section id='writing'>
      <div class='sec-head'>
        <h2 class='sec-title'>Writing<span class='zh'>文章</span></h2>
        <a class='sec-note mono' href='/blog'>全部 {allPosts.length} 篇 →</a>
      </div>
      <WritingIndex posts={byDate} limit={10} id='home-writing' />
    </section>
  </main>
</PageLayout>

<script>
  // 10fps posterize-time risograph boil for DESSN mouse card (0.mp4 technique)
  const turb = document.getElementById('riso-turb')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (turb && !reduce) {
    let seed = 2
    window.setInterval(() => {
      seed = (seed % 7) + 1
      turb.setAttribute('seed', String(seed))
    }, 100)
  }
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 1.5rem 0 2.25rem;
  }
  .hero-top {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: 2.5rem;
    align-items: start;
    padding-bottom: 1.75rem;
  }
  .who {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.65rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: hsl(var(--muted-foreground));
    margin: 0 0 0.9rem;
  }
  .who span:nth-child(n + 3)::before {
    content: '/';
    margin-right: 0.65rem;
    color: hsl(var(--faint));
  }
  h1 {
    font-family: var(--font-body);
    font-size: clamp(2.35rem, 4.6vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.032em;
    line-height: 1.09;
    margin: 0;
    color: hsl(var(--foreground));
  }
  .sub-en {
    display: block;
    font-size: clamp(0.98rem, 1.5vw, 1.2rem);
    letter-spacing: -0.015em;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
    margin-top: 0.7rem;
  }
  .hw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 1.1rem;
  }
  .hw-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    padding: 3px 7px;
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
  }
  .hero-right {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }
  .hero-lead {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.72;
    color: hsl(var(--muted-foreground));
  }
  .hero-lead strong {
    color: hsl(var(--foreground));
    font-weight: 500;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    border: 1.5px solid var(--ink-hard, #171716);
    border-radius: 2px;
    text-decoration: none;
    transition:
      background-color 0.16s ease,
      color 0.16s ease,
      border-color 0.16s ease;
  }
  .cta-solid {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    border-color: hsl(var(--foreground));
  }
  .cta-solid:hover {
    background: var(--c-l6);
    border-color: var(--c-l6);
    color: #fff;
  }
  .cta-ghost {
    background: hsl(var(--card));
    color: hsl(var(--foreground));
  }
  .cta-ghost:hover {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .pg {
    margin: 0;
    padding: 0.65rem 0.9rem;
    border-left: 2px solid var(--c-l6);
    background: hsl(var(--card) / 0.82);
  }
  .pg p {
    margin: 0 0 0.35rem;
