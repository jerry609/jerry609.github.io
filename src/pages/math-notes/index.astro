---
import type { CollectionEntry } from 'astro:content'
import { getEntry, render } from 'astro:content'

import katex from 'katex'
import 'katex/dist/katex.min.css'
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { MATH_ROADMAP } from '@/data/math-roadmap'
import { CORE_MAP, PDFS, TRACKS } from '@/data/math-notes'
import { layerLabel, sourceLabel } from '@/data/stack'

const posts = (await getBlogCollection('blog')) as CollectionEntry<'blog'>[]
const bySlug = Object.fromEntries(posts.map((p) => [p.id, p]))
const tex = (s: string) => katex.renderToString(s, { displayMode: true, throwOnError: false, strict: false })
const day = (d: Date) => d.toISOString().slice(0, 10)
const pad = (n: number) => String(n).padStart(2, '0')

// Number every card across tracks: EQ. 01, 02, …
const TRACK_COLORS = ['#108D47', '#00CD6E', '#FA6D01', '#DE99FE', '#2B5CFF']
let n = 0
const tracks = TRACKS.map((t, ti) => ({
  ...t,
  accent: TRACK_COLORS[ti % TRACK_COLORS.length],
  cards: t.notes.filter((c) => bySlug[c.slug]).map((c) => ({ ...c, post: bySlug[c.slug], no: ++n }))
}))
const noteCount = n

// ---- Study path (from the math toolkit post) ----
const groups = MATH_ROADMAP.children ?? []
const find = (prefix: string) => groups.find((g) => g.title.startsWith(prefix))
const principles = find('现代数学总纲')
const mainline = find('主线地图')
const core = find('第一版')
const coreIds = new Set(Object.values(CORE_MAP).flat())
const coreCount = core?.problems?.length ?? Object.keys(CORE_MAP).length
const toolGroups = groups.filter((g) => /^[A-E]\./.test(g.title))
const toolCount = toolGroups.reduce((s, g) => s + (g.problems?.length ?? 0), 0)

// Anchors: read the toolkit post's real heading slugs so each group links to its section
const toolkit = await getEntry('blog', 'math-toolkit-collection')
const { headings } = toolkit ? await render(toolkit) : { headings: [] }
const anchorFor = (title: string) => {
  const h = headings.find((x) => x.text.replace(/#$/, '').trim() === title.trim())
  return `/blog/math-toolkit-collection${h ? `#${h.slug}` : ''}`
}
const firstSentence = (d?: string) => {
  const s = (d ?? '').replace(/​/g, '').split('。')[0].trim()
  return s ? `${s}。` : ''
}
const groupName = (t: string) => t.replace(/^[A-E]\.\s*/, '').replace(/：\d+\s*个$/, '')
---

<PageLayout meta={{ title: '数学笔记', description: '按公式索引的数学笔记：概率统计、线性模型、信息论投影与训练动力学' }}>
  <header class='page-intro'>
    <p class='eyebrow mono'>
      <span>Math notes</span><span>{noteCount} notes</span><span>{toolCount} tools</span><span
        >{PDFS.length} PDFs</span
      >
    </p>
    <h1>Math <small>数学笔记</small></h1>
    <p class='lede'>
      模型和系统背后用到的数学。每篇笔记用它最核心的一条公式做索引，公式都摘自原文；点开是完整推导。
    </p>
  </header>

  <nav class='toc mono' aria-label='主题'>
    {
      tracks.map((t) => (
        <a href={`#${t.id}`}>
          {t.zh}
          <span>{t.cards.length}</span>
        </a>
      ))
    }
    <a href='#path'>学习路线<span>{toolCount}</span></a>
    <a href='#pdfs'>讲义 PDF<span>{PDFS.length}</span></a>
  </nav>

  {
    tracks.map((t) => (
      <section class='track' id={t.id} style={`--track-c:${t.accent}`}>
        <div class='track-head'>
          <p class='mono en'>
            <span class='sq-dot' style={`background:${t.accent};margin-right:6px`} aria-hidden='true' />
            {t.en}
          </p>
          <h2>{t.zh}</h2>
          <p class='desc'>{t.desc}</p>
        </div>
        <div class='eqs' style={`--cols:${t.cards.length === 3 ? 3 : 2}`}>
          {t.cards.map((c) => (
            <a class='eqcard' href={`/blog/${c.post.id}`}>
              <span class='top mono'>
                <span>Eq. {pad(c.no)}</span>
                <span>{layerLabel(c.post.data.layer)}</span>
                <span>{day(c.post.data.publishDate)}</span>
              </span>
              <span class='formula'>
                {'eq' in c && <span class='eq' set:html={tex(c.eq)} />}
                {'code' in c && <pre class='code'>{c.code}</pre>}
                {'outline' in c && (
                  <span class='flow mono'>
                    {c.outline.map((o, i) => (
                      <>
                        {i > 0 && <i>→</i>}
                        <span>{o}</span>
                      </>
                    ))}
                  </span>
                )}
              </span>
              <span class='foot'>
                <span class='title'>{c.post.data.title}</span>
                <span class='sum'>{c.post.data.description}</span>
                {c.post.data.source && <span class='chip'>{sourceLabel(c.post.data.source)}</span>}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <section class='track' id='path'>
    <div class='track-head'>
      <p class='mono en'>Study path</p>
      <h2>学习路线</h2>
      <p class='desc'>
        从<a href='/blog/math-toolkit-collection'>数学工具集合</a>整理出的主线：用 x≈Dh 串起线性代数、最小二乘、正则化、凸优化和对偶。第一版的 {coreCount}
        个核心工具（对应 {coreIds.size} 个原子工具）标了 core，可以先学这些。
      </p>
    </div>

    {
      mainline?.problems && (
        <figure class='fig-inline'>
          <p class='mono label'>
            <span>主线 · {mainline.problems.length} 步</span>
            <a href={anchorFor(mainline.title)}>在文章中查看 →</a>
          </p>
          <ol class='steps'>
            {mainline.problems.map((p) => (
              <li>
                <span class='mono sc'>{p.id}</span>
                <span class='st'>{p.title}</span>
              </li>
            ))}
          </ol>
        </figure>
      )
    }

    <div class='groups'>
      {
        toolGroups.map((g) => (
          <section class='group'>
            <header>
              <span class='letter mono'>{g.title.slice(0, 1)}</span>
              <span class='gname'>{groupName(g.title)}</span>
              <span class='mono gcount'>{g.problems?.length ?? 0}</span>
            </header>
            {g.desc && <p class='gdesc'>{firstSentence(g.desc)}</p>}
            <ul>
              {(g.problems ?? []).map((p) => (
                <li class:list={[coreIds.has(p.id) && 'is-core']}>
                  <span class='mono tc'>{p.id}</span>
                  <span>{p.title}</span>
                  {coreIds.has(p.id) && <span class='core mono'>core</span>}
                </li>
              ))}
            </ul>
            <a class='mono more' href={anchorFor(g.title)}>
              在文章中查看 →
            </a>
          </section>
        ))
      }
    </div>

    {
      principles?.problems && (
        <details class='principles'>
          <summary>
            <span class='mono'>总纲</span>
            {groupName(principles.title)} · {principles.problems.length} 条
          </summary>
          <ul>
            {principles.problems.map((p) => (
              <li>
                <span class='mono tc'>{p.id}</span>
                {p.title}
              </li>
            ))}
          </ul>
          <a class='mono more' href={anchorFor(principles.title)}>
            在文章中查看 →
          </a>
        </details>
      )
    }
  </section>

  <section class='track' id='pdfs'>
    <div class='track-head'>
      <p class='mono en'>Lecture Notes</p>
      <h2>讲义 PDF</h2>
      <p class='desc'>成体系的长文整理成了 PDF，可以直接下载离线读。每份都对应一篇在线文章。</p>
    </div>
    <ul class='pdfs'>
      {
        PDFS.map((f) => (
          <li>
            <a class='pdf' href={`/pdf/${f.file}`} target='_blank' rel='noopener'>
              <span class='mono ext'>PDF</span>
              <span class='pdf-main'>
                <span class='pdf-t'>{f.title}</span>
                <span class='pdf-n'>{f.note}</span>
              </span>
              <span class='mono size'>{f.size}</span>
            </a>
            {bySlug[f.post] && (
              <a class='mono post-link' href={`/blog/${f.post}`}>
                在线阅读 →
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .toc a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }
  .toc a:hover {
    color: hsl(var(--primary));
  }
  .toc span {
    margin-left: 0.375rem;
    color: hsl(var(--faint));
  }
  .track {
    padding-block: 2.5rem;
    border-top: var(--hair) solid hsl(var(--border));
    scroll-margin-top: 4.5rem;
  }
  .track-head {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    column-gap: 2.5rem;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }
  .track-head .en {
    grid-column: 1;
    margin: 0;
    color: hsl(var(--faint));
  }
  .track-head h2 {
    grid-column: 1;
    margin: 0.3rem 0 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .track-head .desc {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    margin: 0;
    max-width: 40rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .track-head .desc a {
    color: hsl(var(--primary));
  }
  /* Formula cards */
  .eqs {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
    gap: 1rem;
  }
  .eqcard {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
    min-height: 15rem;
    padding: 0.9rem 1.1rem 1rem;
    border: 1.5px solid var(--ink-hard, #171716);
    border-top: 4px solid var(--track-c, var(--c-l1));
    border-radius: 0;
    background: hsl(var(--card));
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s cubic-bezier(0.32, 0.72, 0, 1),
      border-color 0.15s ease;
    min-width: 0;
    container-type: inline-size;
  }
  .eqcard:hover {
    transform: translateY(-2px);
    color: inherit;
  }
  .eqcard:hover .title {
    color: hsl(var(--primary));
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--faint));
  }
  .top span:first-child {
    color: hsl(var(--foreground));
  }
  .formula {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 0.5rem 0;
    border-block: var(--hair) dashed hsl(var(--border));
    background: radial-gradient(hsl(var(--border)) 1px, transparent 1px) 0 0 / 10px 10px;
  }
  .eq {
    max-width: 100%;
    overflow-x: auto;
    /* Display math can't wrap: scale it to the card instead */
    font-size: clamp(0.72rem, 3.7cqw, 1.15rem);
    color: hsl(var(--foreground));
    padding: 0 0.25rem;
    background: hsl(var(--card));
  }
  .eq :global(.katex-display) {
    margin: 0.4rem 0;
    padding: 0;
    overflow: visible;
  }
  .code {
    margin: 0;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
    border-radius: var(--radius);
  }
  .flow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.72rem;
    padding: 0.25rem 0.75rem;
    background: hsl(var(--card));
  }
  .flow span {
    border: var(--hair) solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 0.1rem 0.4rem;
    color: hsl(var(--foreground));
  }
  .flow i {
    font-style: normal;
    color: hsl(var(--faint));
  }
  .foot {
    display: grid;
    gap: 0.25rem;
  }
  .title {
    font-weight: 600;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .sum {
    font-size: 0.82rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot .chip {
    justify-self: start;
    margin-top: 0.2rem;
  }
  /* Study path */
  .fig-inline {
    margin: 0 0 1.5rem;
  }
  .label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.6rem;
    color: hsl(var(--faint));
    font-size: 0.72rem;
  }
  .label a,
  .more {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }
  .label a:hover,
  .more:hover {
    color: hsl(var(--primary));
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border: 1.5px solid #020100;
    border-radius: 2px;
    background: #1d1d1d;
    color: #f0f0ef;
  }
  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.85rem 0.85rem 0.9rem;
    border-left: 1px solid #30302e;
    font-size: 0.8rem;
    line-height: 1.5;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .steps li:first-child {
    border-left: 0;
    box-shadow: inset 0 3px 0 var(--c-l6, #fa6d01);
  }
  .sc {
    font-size: 0.62rem;
    color: var(--c-l2, #00cd6e);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .group {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.15rem 1.1rem;
    border: 1.5px solid var(--ink-hard, #171716);
    border-radius: 0;
    background: hsl(var(--card));
    min-width: 0;
  }
  .group header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .letter {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    border-radius: var(--radius);
    align-self: center;
  }
  .gname {
    font-weight: 600;
  }
  .gcount {
    margin-left: auto;
    font-size: 0.72rem;
    color: hsl(var(--faint));
  }
  .gdesc {
    margin: 0.5rem 0 0.6rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }
  .group ul,
  .principles ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
    font-size: 0.85rem;
  }
  .group li,
  .principles li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .tc {
    min-width: 2.1rem;
    font-size: 0.66rem;
    color: hsl(var(--faint));
  }
  .group li.is-core {
    color: hsl(var(--foreground));
  }
  .group li:not(.is-core) {
    color: hsl(var(--muted-foreground));
  }
  .core {
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    border: var(--hair) solid hsl(var(--scarf) / 0.7);
    border-radius: var(--radius);
    padding: 0 0.25rem;
  }
  .more {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.72rem;
  }
  .principles {
    margin-top: 1rem;
    border: var(--hair) solid hsl(var(--border));
    border-radius: var(--radius-box);
    background: hsl(var(--card));
    padding: 0 1.1rem;
  }
  .principles summary {
    cursor: pointer;
    padding: 0.75rem 0;
    font-weight: 500;
  }
  .principles summary .mono {
    font-size: 0.7rem;
    color: hsl(var(--faint));
    margin-right: 0.4rem;
  }
  .principles ul {
    padding-bottom: 0.5rem;
  }
  .principles .more {
    display: inline-block;
    padding: 0.25rem 0 0.9rem;
  }
  /* PDFs */
  .pdfs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
  }
  .pdfs li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .pdf {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.875rem;
    align-items: center;
    padding: 1rem 1.1rem;
    border: 1.5px solid var(--ink-hard, #171716);
    border-top: 4px solid var(--c-l6, #fa6d01);
    border-radius: 0;
    background: var(--cream, #f4f3e6);
    text-decoration: none;
    color: #171716;
    transition: transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .pdf:hover {
    transform: translateY(-2px);
    color: #171716;
  }
  .ext {
    font-size: 0.66rem;
    border: 1px solid #171716;
    background: #171716;
    color: #f4f3e6;
    padding: 0.18rem 0.42rem;
    border-radius: 2px;
  }
  .pdf-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pdf-t {
    font-weight: 500;
    color: #171716;
  }
  .pdf-n {
    color: #50504e;
    font-size: 0.84rem;
  }
  .size {
    color: #50504e;
  }
  .post-link {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    padding-left: 0.25rem;
  }
  .post-link:hover {
    color: hsl(var(--primary));
  }
  @media (max-width: 1100px) {
    .eqs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .steps li:nth-child(5) {
      border-left: 0;
    }
    .steps li:nth-child(n + 5) {
      border-top: var(--hair) solid hsl(var(--border));
    }
  }
  @media (max-width: 860px) {
    .track-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .track-head .desc {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.6rem;
    }
    .eqs,
    .groups,
    .pdfs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps li,
    .steps li:nth-child(5) {
      border-left: 0;
      border-top: var(--hair) solid hsl(var(--border));
    }
    .steps li:first-child {
      border-top: 0;
    }
  }
</style>
