---
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection, groupCollectionsByYear, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { layerLabel } from '@/data/stack'

export const prerender = true

const allPosts = (await getBlogCollection('blog')) as CollectionEntry<'blog'>[]
const byYear = groupCollectionsByYear<'blog'>(sortMDByDate(allPosts))
const day = (d: Date) => d.toISOString().slice(5, 10)
---

<PageLayout meta={{ title: '归档', description: '按年份排列的全部文章' }}>
  <header class='page-intro'>
    <p class='eyebrow mono'><span>Archives</span><span>{allPosts.length} posts</span></p>
    <h1>Archives <small>归档</small></h1>
    <p class='lede'>按年份排列的全部文章。想按主题看，去 <a href='/blog'>文章</a> 页按栈层筛选。</p>
  </header>

  {
    byYear.map(([year, posts]) => (
      <section class='year'>
        <h2>
          <span class='mono y'>{year}</span>
          <span class='mono n'>{posts.length} 篇</span>
        </h2>
        <ul class='rows'>
          {posts.map((p) => (
            <li>
              <a class='row' href={`/blog/${p.id}`}>
                <span class='row-d mono'>{day(p.data.publishDate)}</span>
                <span class='row-t'>{p.data.title}</span>
                <span class='row-l mono'>{layerLabel(p.data.layer)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</PageLayout>

<style>
  .page-intro a {
    color: hsl(var(--primary));
  }
  .year {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .year h2 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-weight: 500;
  }
  .y {
    font-size: 1.5rem !important;
    color: hsl(var(--foreground));
  }
  .n {
    color: hsl(var(--faint));
  }
  .year .row {
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    padding-block: 0.6rem;
  }
  @media (max-width: 640px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
    .year h2 {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
  }
</style>
