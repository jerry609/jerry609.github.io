---
import PageLayout from '@/layouts/BaseLayout.astro'
import Placeholder from '@/components/brand/Placeholder.astro'
---

<PageLayout meta={{ title: '404', description: '页面不存在' }}>
  <Placeholder
    variant='puzzled'
    code='HTTP 404 · ENOENT'
    title='这一页不存在'
    message='链接可能改过了。回首页，或者用搜索找找。'
  >
    <a class='btn' href='/search'>搜索</a>
  </Placeholder>
</PageLayout>
